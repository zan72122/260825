const app = document.querySelector('#app');
const canvas = document.querySelector('#scene-canvas');
const staticFallback = document.querySelector('#static-fallback');
const copyPanel = document.querySelector('#copy-panel');
const sceneNumber = document.querySelector('#scene-number');
const scenePlace = document.querySelector('#scene-place');
const sceneKicker = document.querySelector('#scene-kicker');
const sceneTitle = document.querySelector('#scene-title');
const sceneDescription = document.querySelector('#scene-description');
const materialCaption = document.querySelector('#material-caption');
const startOverline = document.querySelector('#start-overline');
const startLabel = document.querySelector('#start-label');
const startButton = document.querySelector('#start-button');
const previousButton = document.querySelector('#previous-button');
const nextButton = document.querySelector('#next-button');
const variantDots = document.querySelector('#variant-dots');
const infoButton = document.querySelector('#info-button');
const soundButton = document.querySelector('#sound-button');
const infoModal = document.querySelector('#info-modal');
const startModal = document.querySelector('#start-modal');
const startModalCopy = document.querySelector('#start-modal-copy');
const toast = document.querySelector('#toast');

const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.setClearColor(0x171511, 1);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(35, 1, 0.08, 180);
camera.position.set(12, 7, 17);
const cameraTarget = new THREE.Vector3(0, 4.6, 0);
const baseCameraPosition = new THREE.Vector3();
const desiredCameraPosition = new THREE.Vector3();
const clock = new THREE.Clock();

let activeRoot = new THREE.Group();
scene.add(activeRoot);
let activeVariantIndex = 0;
let switching = false;
let soundEnabled = false;
let toastTimer = 0;
let audioContext = null;
let pointerDown = false;
let pointerStartX = 0;
let pointerStartY = 0;
let pointerLastX = 0;
let pointerLastY = 0;
let pointerMoved = false;
let parallaxX = 0;
let parallaxY = 0;
let targetParallaxX = 0;
let targetParallaxY = 0;
let worldUpdate = null;

const clamp = THREE.MathUtils.clamp;
const lerp = THREE.MathUtils.lerp;
const deg = THREE.MathUtils.degToRad;
const tmpVecA = new THREE.Vector3();
const tmpVecB = new THREE.Vector3();
const tmpVecC = new THREE.Vector3();
const tmpQuat = new THREE.Quaternion();
const upAxis = new THREE.Vector3(0, 1, 0);

function mulberry32(seed) {
  let t = seed >>> 0;
  return function random() {
    t += 0x6D2B79F5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

function range(random, min, max) { return min + (max - min) * random(); }
function signed(random, magnitude = 1) { return (random() * 2 - 1) * magnitude; }
function choose(random, items) { return items[Math.floor(random() * items.length) % items.length]; }

function standardMaterial(color, roughness = 0.72, metalness = 0, extra = {}) {
  return new THREE.MeshStandardMaterial({ color, roughness, metalness, ...extra });
}

function physicalMaterial(color, roughness = 0.35, metalness = 0, extra = {}) {
  return new THREE.MeshPhysicalMaterial({ color, roughness, metalness, ...extra });
}

function setShadows(object, cast = true, receive = true) {
  object.traverse((child) => {
    if (child.isMesh) {
      child.castShadow = cast;
      child.receiveShadow = receive;
    }
  });
  return object;
}

function addBox(parent, size, position, material, rotation = null, bevel = 0) {
  const geometry = bevel > 0
    ? new THREE.BoxGeometry(size.x, size.y, size.z, 2, 2, 2)
    : new THREE.BoxGeometry(size.x, size.y, size.z);
  const mesh = new THREE.Mesh(geometry, material);
  mesh.position.copy(position);
  if (rotation) mesh.rotation.set(rotation.x, rotation.y, rotation.z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addPlane(parent, size, position, material, rotation = new THREE.Euler(-Math.PI / 2, 0, 0)) {
  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(size.x, size.y), material);
  mesh.position.copy(position);
  mesh.rotation.copy(rotation);
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addDisc(parent, radius, position, material, rotation = new THREE.Euler(-Math.PI / 2, 0, 0), segments = 48) {
  const mesh = new THREE.Mesh(new THREE.CircleGeometry(radius, segments), material);
  mesh.position.copy(position);
  mesh.rotation.copy(rotation);
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addCylinder(parent, radiusTop, radiusBottom, height, position, material, segments = 16, rotation = null) {
  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radiusTop, radiusBottom, height, segments, 1, false), material);
  mesh.position.copy(position);
  if (rotation) mesh.rotation.set(rotation.x, rotation.y, rotation.z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addSphere(parent, radius, position, material, segments = 18) {
  const mesh = new THREE.Mesh(new THREE.SphereGeometry(radius, segments, Math.max(10, Math.round(segments * .65))), material);
  mesh.position.copy(position);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addCone(parent, radius, height, position, material, segments = 12, rotation = null) {
  const mesh = new THREE.Mesh(new THREE.ConeGeometry(radius, height, segments), material);
  mesh.position.copy(position);
  if (rotation) mesh.rotation.set(rotation.x, rotation.y, rotation.z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function cylinderBetween(parent, start, end, radiusStart, radiusEnd, material, segments = 8) {
  const direction = tmpVecA.copy(end).sub(start);
  const length = direction.length();
  if (length < 0.0001) return null;
  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radiusEnd, radiusStart, length, segments, 1, false), material);
  mesh.position.copy(start).addScaledVector(direction, .5);
  mesh.quaternion.setFromUnitVectors(upAxis, direction.normalize());
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addLine(parent, points, color, opacity = 1, linewidth = 1) {
  const geometry = new THREE.BufferGeometry().setFromPoints(points);
  const material = new THREE.LineBasicMaterial({ color, transparent: opacity < 1, opacity, linewidth });
  const line = new THREE.Line(geometry, material);
  parent.add(line);
  return line;
}

function addTube(parent, points, radius, material, tubularSegments = 32, radialSegments = 6) {
  const curve = new THREE.CatmullRomCurve3(points);
  const mesh = new THREE.Mesh(new THREE.TubeGeometry(curve, tubularSegments, radius, radialSegments, false), material);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function makeNoiseTexture(seed = 1, base = '#77706a', speck = '#4e4944', size = 128) {
  const random = mulberry32(seed);
  const source = document.createElement('canvas');
  source.width = source.height = size;
  const context = source.getContext('2d');
  context.fillStyle = base;
  context.fillRect(0, 0, size, size);
  for (let i = 0; i < size * 7; i += 1) {
    const alpha = range(random, .015, .09);
    context.fillStyle = `${speck}${Math.round(alpha * 255).toString(16).padStart(2, '0')}`;
    const r = range(random, .4, 2.4);
    context.beginPath();
    context.arc(random() * size, random() * size, r, 0, Math.PI * 2);
    context.fill();
  }
  const texture = new THREE.CanvasTexture(source);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.wrapS = texture.wrapT = THREE.RepeatWrapping;
  texture.repeat.set(8, 8);
  texture.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
  return texture;
}

function addGroundScuffs(parent, random, bounds, color = 0x27231f, count = 16) {
  const material = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: .12, depthWrite: false });
  for (let i = 0; i < count; i += 1) {
    const radius = range(random, .08, .38);
    const patch = new THREE.Mesh(new THREE.CircleGeometry(radius, 12), material);
    patch.rotation.x = -Math.PI / 2;
    patch.scale.set(range(random, .5, 1.9), range(random, .5, 1.2), 1);
    patch.position.set(range(random, bounds.x[0], bounds.x[1]), .006, range(random, bounds.z[0], bounds.z[1]));
    patch.rotation.z = random() * Math.PI;
    parent.add(patch);
  }
}

function addRectFrame(parent, width, height, depth, position, material, thickness = .12) {
  const group = new THREE.Group();
  group.position.copy(position);
  addBox(group, new THREE.Vector3(thickness, height, depth), new THREE.Vector3(-width / 2, 0, 0), material);
  addBox(group, new THREE.Vector3(thickness, height, depth), new THREE.Vector3(width / 2, 0, 0), material);
  addBox(group, new THREE.Vector3(width + thickness, thickness, depth), new THREE.Vector3(0, height / 2, 0), material);
  addBox(group, new THREE.Vector3(width + thickness, thickness, depth), new THREE.Vector3(0, -height / 2, 0), material);
  parent.add(group);
  return group;
}

function addAmbientRig(root, options = {}) {
  const hemi = new THREE.HemisphereLight(options.sky ?? 0xb8c7d2, options.ground ?? 0x2b241d, options.hemi ?? 1.1);
  root.add(hemi);
  const key = new THREE.DirectionalLight(options.keyColor ?? 0xffe2ba, options.key ?? 2.5);
  key.position.copy(options.keyPosition ?? new THREE.Vector3(-7, 13, 8));
  key.castShadow = options.shadows !== false;
  key.shadow.mapSize.set(isCoarsePointer ? 1024 : 1536, isCoarsePointer ? 1024 : 1536);
  key.shadow.camera.near = .5;
  key.shadow.camera.far = 45;
  key.shadow.camera.left = -12;
  key.shadow.camera.right = 12;
  key.shadow.camera.top = 17;
  key.shadow.camera.bottom = -8;
  key.shadow.bias = -.00035;
  root.add(key);
  if (options.fill !== false) {
    const fill = new THREE.DirectionalLight(options.fillColor ?? 0x93a6b0, options.fillIntensity ?? .55);
    fill.position.copy(options.fillPosition ?? new THREE.Vector3(8, 7, -9));
    root.add(fill);
  }
  return { hemi, key };
}

function addPracticalPointLight(parent, position, color, intensity, distance, radius = .04, visibleBulb = true) {
  const light = new THREE.PointLight(color, intensity, distance, 2);
  light.position.copy(position);
  parent.add(light);
  if (visibleBulb) {
    const bulbMaterial = new THREE.MeshBasicMaterial({ color });
    addSphere(parent, radius, position, bulbMaterial, 10).castShadow = false;
  }
  return light;
}

function disposeMaterial(material) {
  if (!material) return;
  for (const value of Object.values(material)) {
    if (value && value.isTexture) value.dispose();
  }
  material.dispose?.();
}

function disposeWorld(root) {
  const geometries = new Set();
  const materials = new Set();
  root.traverse((object) => {
    if (object.geometry) geometries.add(object.geometry);
    if (Array.isArray(object.material)) object.material.forEach((material) => materials.add(material));
    else if (object.material) materials.add(object.material);
  });
  geometries.forEach((geometry) => geometry.dispose());
  materials.forEach(disposeMaterial);
  root.removeFromParent();
}

function configureScene({ background = 0x171511, fog = null, exposure = 1.05, cameraPosition, target, fov = 35 }) {
  scene.background = new THREE.Color(background);
  scene.fog = fog ? new THREE.FogExp2(fog.color, fog.density) : null;
  renderer.toneMappingExposure = exposure;
  camera.fov = fov;
  camera.updateProjectionMatrix();
  baseCameraPosition.copy(cameraPosition);
  desiredCameraPosition.copy(cameraPosition);
  camera.position.copy(cameraPosition);
  cameraTarget.copy(target);
  camera.lookAt(cameraTarget);
}

function makeWorld() {
  const root = new THREE.Group();
  root.name = 'active-world';
  return root;
}

function resizeRenderer() {
  const width = Math.max(1, window.innerWidth);
  const height = Math.max(1, window.innerHeight);
  const pixelRatioLimit = isCoarsePointer ? 1.65 : 2;
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, pixelRatioLimit));
  renderer.setSize(width, height, false);
  camera.aspect = width / height;
  camera.updateProjectionMatrix();
}

function announce(message) {
  clearTimeout(toastTimer);
  toast.textContent = message;
  toast.classList.add('is-visible');
  toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
}

function unlockAudio() {
  if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
  if (audioContext.state === 'suspended') audioContext.resume();
}

function playTone(frequency = 520, duration = .08, volume = .035) {
  if (!soundEnabled) return;
  unlockAudio();
  const now = audioContext.currentTime;
  const oscillator = audioContext.createOscillator();
  const gain = audioContext.createGain();
  oscillator.type = 'sine';
  oscillator.frequency.setValueAtTime(frequency, now);
  oscillator.frequency.exponentialRampToValueAtTime(frequency * .74, now + duration);
  gain.gain.setValueAtTime(.0001, now);
  gain.gain.exponentialRampToValueAtTime(volume, now + .012);
  gain.gain.exponentialRampToValueAtTime(.0001, now + duration);
  oscillator.connect(gain).connect(audioContext.destination);
  oscillator.start(now);
  oscillator.stop(now + duration + .02);
}

resizeRenderer();
window.addEventListener('resize', resizeRenderer, { passive: true });
