function createNeedleGeometry() {
  const vertices = [];
  const indices = [];
  const bladeCount = 7;
  for (let i = 0; i < bladeCount; i += 1) {
    const angle = (i / bladeCount) * Math.PI * 2 + (i % 2) * .17;
    const width = .018;
    const length = .34 + (i % 3) * .035;
    const baseIndex = vertices.length / 3;
    const sideX = Math.cos(angle + Math.PI / 2) * width;
    const sideZ = Math.sin(angle + Math.PI / 2) * width;
    const dirX = Math.cos(angle) * .12;
    const dirZ = Math.sin(angle) * .12;
    vertices.push(-sideX, 0, -sideZ, sideX, 0, sideZ, dirX, length, dirZ);
    indices.push(baseIndex, baseIndex + 1, baseIndex + 2);
  }
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
  geometry.setIndex(indices);
  geometry.computeVertexNormals();
  return geometry;
}

function createFraserFir(parent, options = {}) {
  const random = mulberry32(options.seed ?? 2107);
  const height = options.height ?? 10.5;
  const baseY = options.baseY ?? 0;
  const baseRadius = options.radius ?? height * .29;
  const trunkRadius = options.trunkRadius ?? height * .026;
  const density = options.density ?? 1;
  const foliageColor = options.foliageColor ?? 0x163d2a;
  const foliageColor2 = options.foliageColor2 ?? 0x28523a;
  const barkMaterial = standardMaterial(options.barkColor ?? 0x513a28, .94, 0);
  const branchMaterial = standardMaterial(options.branchColor ?? 0x3c3427, .92, 0);
  const foliageMaterialA = standardMaterial(foliageColor, .86, 0, { side: THREE.DoubleSide });
  const foliageMaterialB = standardMaterial(foliageColor2, .83, 0, { side: THREE.DoubleSide });
  const group = new THREE.Group();
  group.position.set(options.x ?? 0, 0, options.z ?? 0);
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);

  const trunkSegments = Math.max(4, Math.round(height / 2.2));
  let trunkStart = new THREE.Vector3(0, baseY, 0);
  const trunkPoints = [trunkStart.clone()];
  for (let i = 0; i < trunkSegments; i += 1) {
    const f0 = i / trunkSegments;
    const f1 = (i + 1) / trunkSegments;
    const next = new THREE.Vector3(
      signed(random, height * .008) * f1,
      baseY + f1 * height,
      signed(random, height * .006) * f1,
    );
    cylinderBetween(group, trunkStart, next, trunkRadius * (1 - f0 * .62), trunkRadius * (1 - f1 * .62), barkMaterial, 10);
    trunkStart = next;
    trunkPoints.push(next.clone());
  }

  const branchCount = Math.round(height * 9.5 * density);
  const branchRecords = [];
  const sprayRecords = [];
  const ornamentAnchors = [];
  const lightAnchors = [];
  const lowerClearance = options.lowerClearance ?? .07;
  for (let i = 0; i < branchCount; i += 1) {
    const level = lowerClearance + (1 - lowerClearance) * (i / Math.max(1, branchCount - 1));
    const y = baseY + height * level + signed(random, height * .008);
    const envelope = Math.pow(Math.max(0, 1 - level), .58);
    const irregular = .84 + random() * .26;
    const branchLength = baseRadius * envelope * irregular + height * .045;
    const angle = i * 2.399963 + signed(random, .22);
    const droop = lerp(-.22, .14, level) + signed(random, .07);
    const originRadius = trunkRadius * (1 - level * .55);
    const origin = new THREE.Vector3(Math.cos(angle) * originRadius, y, Math.sin(angle) * originRadius);
    const end = new THREE.Vector3(
      Math.cos(angle) * branchLength,
      y + branchLength * droop,
      Math.sin(angle) * branchLength,
    );
    const radius = Math.max(.018, trunkRadius * (.42 * envelope + .07));
    cylinderBetween(group, origin, end, radius, radius * .18, branchMaterial, 7);
    branchRecords.push({ origin, end, level, angle, length: branchLength });

    const secondaryCount = Math.max(2, Math.round(branchLength * 1.6 * density));
    for (let j = 0; j < secondaryCount; j += 1) {
      const t = .18 + (j / secondaryCount) * .72 + signed(random, .035);
      const base = origin.clone().lerp(end, clamp(t, .08, .94));
      const side = j % 2 === 0 ? 1 : -1;
      const tangent = end.clone().sub(origin).normalize();
      const radial = new THREE.Vector3(Math.cos(angle + Math.PI / 2), 0, Math.sin(angle + Math.PI / 2));
      const secondaryLength = branchLength * range(random, .16, .31) * (1 - t * .28);
      const secEnd = base.clone()
        .addScaledVector(radial, secondaryLength * side)
        .addScaledVector(tangent, secondaryLength * range(random, .08, .24))
        .add(new THREE.Vector3(0, signed(random, secondaryLength * .13), 0));
      cylinderBetween(group, base, secEnd, radius * .27, radius * .06, branchMaterial, 6);
      const sprayCount = Math.max(2, Math.round(secondaryLength * 5.2 * density));
      for (let k = 0; k < sprayCount; k += 1) {
        const sprayT = (k + .35) / sprayCount;
        const position = base.clone().lerp(secEnd, sprayT);
        position.y += signed(random, .035);
        sprayRecords.push({
          position,
          direction: secEnd.clone().sub(base).normalize(),
          scale: range(random, .72, 1.22),
          roll: random() * Math.PI * 2,
          tone: random() > .7 ? 1 : 0,
        });
      }
    }

    const mainSprays = Math.max(4, Math.round(branchLength * 4 * density));
    for (let j = 0; j < mainSprays; j += 1) {
      const t = .08 + (j / mainSprays) * .9;
      const position = origin.clone().lerp(end, t);
      position.add(new THREE.Vector3(signed(random, .06), signed(random, .06), signed(random, .06)));
      sprayRecords.push({
        position,
        direction: end.clone().sub(origin).normalize(),
        scale: range(random, .8, 1.35),
        roll: random() * Math.PI * 2,
        tone: random() > .72 ? 1 : 0,
      });
    }

    if (i % 2 === 0) ornamentAnchors.push(end.clone().lerp(origin, range(random, .04, .3)));
    if (i % 3 === 0) lightAnchors.push(origin.clone().lerp(end, range(random, .45, .92)));
  }

  const needleGeometry = createNeedleGeometry();
  const countA = sprayRecords.filter((record) => record.tone === 0).length;
  const countB = sprayRecords.length - countA;
  const spraysA = new THREE.InstancedMesh(needleGeometry, foliageMaterialA, countA);
  const spraysB = new THREE.InstancedMesh(needleGeometry.clone(), foliageMaterialB, countB);
  spraysA.castShadow = spraysB.castShadow = true;
  spraysA.receiveShadow = spraysB.receiveShadow = true;
  const dummy = new THREE.Object3D();
  let indexA = 0;
  let indexB = 0;
  for (const record of sprayRecords) {
    dummy.position.copy(record.position);
    dummy.quaternion.setFromUnitVectors(upAxis, record.direction.clone().normalize());
    dummy.rotateY(record.roll);
    dummy.scale.set(record.scale, record.scale, record.scale);
    dummy.updateMatrix();
    if (record.tone === 0) spraysA.setMatrixAt(indexA++, dummy.matrix);
    else spraysB.setMatrixAt(indexB++, dummy.matrix);
  }
  spraysA.instanceMatrix.needsUpdate = true;
  spraysB.instanceMatrix.needsUpdate = true;
  group.add(spraysA, spraysB);

  const leaderStart = new THREE.Vector3(0, baseY + height * .88, 0);
  const leaderEnd = new THREE.Vector3(signed(random, .04), baseY + height + .18, signed(random, .04));
  cylinderBetween(group, leaderStart, leaderEnd, trunkRadius * .22, trunkRadius * .05, branchMaterial, 7);
  for (let i = 0; i < 16; i += 1) {
    const y = baseY + height * (.87 + i / 16 * .12);
    const r = baseRadius * .16 * (1 - i / 18);
    const angle = i * 2.2;
    const start = new THREE.Vector3(0, y, 0);
    const end = new THREE.Vector3(Math.cos(angle) * r, y + signed(random, .06), Math.sin(angle) * r);
    cylinderBetween(group, start, end, trunkRadius * .08, trunkRadius * .025, branchMaterial, 5);
    ornamentAnchors.push(end.clone());
  }

  if (options.trunkCutVisible) {
    const cutMaterial = standardMaterial(0xb99668, .82, 0);
    addCylinder(group, trunkRadius * .92, trunkRadius, .025, new THREE.Vector3(0, baseY + .012, 0), cutMaterial, 20);
  }

  return { group, height, baseRadius, baseY, branchRecords, ornamentAnchors, lightAnchors, trunkPoints };
}

function createStarGeometry(points = 5, outer = 1, inner = .42, depth = .16) {
  const shape = new THREE.Shape();
  for (let i = 0; i < points * 2; i += 1) {
    const radius = i % 2 === 0 ? outer : inner;
    const angle = -Math.PI / 2 + i * Math.PI / points;
    const x = Math.cos(angle) * radius;
    const y = Math.sin(angle) * radius;
    if (i === 0) shape.moveTo(x, y); else shape.lineTo(x, y);
  }
  shape.closePath();
  const geometry = new THREE.ExtrudeGeometry(shape, { depth, bevelEnabled: true, bevelSize: depth * .18, bevelThickness: depth * .13, bevelSegments: 1 });
  geometry.center();
  return geometry;
}

function addTreeTopper(parent, tree, options = {}) {
  const material = physicalMaterial(options.color ?? 0xc9a35a, .28, options.metalness ?? .68, { clearcoat: .2 });
  const star = new THREE.Mesh(createStarGeometry(options.points ?? 5, options.size ?? .5, (options.size ?? .5) * .42, .1), material);
  star.position.set(0, tree.baseY + tree.height + (options.offsetY ?? .55), 0);
  star.rotation.y = options.rotationY ?? -.12;
  star.castShadow = true;
  tree.group.add(star);
  const stemMaterial = standardMaterial(0x4a3b2d, .7, .25);
  addCylinder(tree.group, .018, .018, .55, new THREE.Vector3(0, tree.baseY + tree.height + .19, 0), stemMaterial, 8);
  return star;
}

function decorateTree(parent, tree, options = {}) {
  const random = mulberry32(options.seed ?? 991);
  const ornamentPalette = options.ornaments ?? [0x8e2f2f, 0xc6a05a, 0xe8dfcb];
  const count = options.count ?? Math.min(90, tree.ornamentAnchors.length);
  const ornamentMaterials = ornamentPalette.map((color, index) => physicalMaterial(color, index % 2 ? .24 : .38, index % 2 ? .55 : .08, { clearcoat: .35, clearcoatRoughness: .28 }));
  const ornamentGeometry = new THREE.SphereGeometry(options.ornamentSize ?? .12, 14, 10);
  const instancesByMaterial = ornamentMaterials.map(() => []);
  for (let i = 0; i < count; i += 1) {
    const anchor = tree.ornamentAnchors[(i * 7 + 3) % tree.ornamentAnchors.length].clone();
    anchor.x += signed(random, .12);
    anchor.y += signed(random, .08);
    anchor.z += signed(random, .12);
    const materialIndex = i % ornamentMaterials.length;
    instancesByMaterial[materialIndex].push({ position: anchor, scale: range(random, .72, 1.25) });
  }
  instancesByMaterial.forEach((records, materialIndex) => {
    const mesh = new THREE.InstancedMesh(ornamentGeometry.clone(), ornamentMaterials[materialIndex], records.length);
    const dummy = new THREE.Object3D();
    records.forEach((record, index) => {
      dummy.position.copy(record.position);
      dummy.scale.setScalar(record.scale);
      dummy.updateMatrix();
      mesh.setMatrixAt(index, dummy.matrix);
    });
    mesh.instanceMatrix.needsUpdate = true;
    mesh.castShadow = true;
    parent.add(mesh);
  });

  if (options.lights !== false) {
    const lightColor = options.lightColor ?? 0xffd79a;
    const bulbMaterial = new THREE.MeshStandardMaterial({ color: lightColor, emissive: lightColor, emissiveIntensity: 2.2, roughness: .3 });
    const bulbGeometry = new THREE.SphereGeometry(options.bulbSize ?? .035, 8, 6);
    const rings = options.lightRings ?? Math.round(tree.height * .75);
    const bulbs = [];
    const cordPoints = [];
    for (let ring = 0; ring < rings; ring += 1) {
      const level = .12 + ring / Math.max(1, rings - 1) * .76;
      const radius = tree.baseRadius * Math.pow(1 - level, .6) * .82 + .08;
      const perRing = Math.max(8, Math.round(12 * radius / Math.max(.8, tree.baseRadius)));
      for (let j = 0; j <= perRing; j += 1) {
        const a = j / perRing * Math.PI * 2 + ring * .86;
        const point = new THREE.Vector3(Math.cos(a) * radius, tree.baseY + level * tree.height, Math.sin(a) * radius);
        cordPoints.push(point.clone());
        if (j < perRing && (j + ring) % 2 === 0) bulbs.push(point.clone());
      }
    }
    const cordMaterial = standardMaterial(options.cordColor ?? 0x183326, .95, 0);
    const ringsAsCurves = [];
    let cursor = 0;
    for (let ring = 0; ring < rings; ring += 1) {
      const level = .12 + ring / Math.max(1, rings - 1) * .76;
      const radius = tree.baseRadius * Math.pow(1 - level, .6) * .82 + .08;
      const perRing = Math.max(8, Math.round(12 * radius / Math.max(.8, tree.baseRadius)));
      ringsAsCurves.push(cordPoints.slice(cursor, cursor + perRing + 1));
      cursor += perRing + 1;
    }
    ringsAsCurves.forEach((points) => addTube(parent, points, options.cordRadius ?? .012, cordMaterial, Math.max(16, points.length * 2), 4));
    const bulbMesh = new THREE.InstancedMesh(bulbGeometry, bulbMaterial, bulbs.length);
    const dummy = new THREE.Object3D();
    bulbs.forEach((point, index) => {
      dummy.position.copy(point);
      dummy.updateMatrix();
      bulbMesh.setMatrixAt(index, dummy.matrix);
    });
    bulbMesh.instanceMatrix.needsUpdate = true;
    bulbMesh.castShadow = false;
    parent.add(bulbMesh);
    const centerLight = new THREE.PointLight(lightColor, options.lightIntensity ?? 4.5, tree.baseRadius * 3.1, 2);
    centerLight.position.set(0, tree.baseY + tree.height * .52, 0);
    parent.add(centerLight);
  }

  if (options.ribbon) {
    const ribbonMaterial = physicalMaterial(options.ribbonColor ?? 0x8d2e32, .54, .05, { side: THREE.DoubleSide });
    const ribbonPoints = [];
    const loops = options.ribbonLoops ?? 4.2;
    const segments = 96;
    for (let i = 0; i <= segments; i += 1) {
      const t = i / segments;
      const level = .12 + t * .77;
      const radius = tree.baseRadius * Math.pow(1 - level, .62) * .9;
      const angle = t * Math.PI * 2 * loops + .3;
      ribbonPoints.push(new THREE.Vector3(Math.cos(angle) * radius, tree.baseY + level * tree.height, Math.sin(angle) * radius));
    }
    addTube(parent, ribbonPoints, options.ribbonWidth ?? .045, ribbonMaterial, 100, 5);
  }
}

function createTreeStand(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  parent.add(group);
  const steel = standardMaterial(options.steelColor ?? 0x3f4546, .48, .72);
  const darkSteel = standardMaterial(0x252a2a, .58, .65);
  const waterMaterial = physicalMaterial(0x304f55, .12, 0, { transmission: .2, transparent: true, opacity: .78 });
  const basinRadius = options.radius ?? .85;
  const basinHeight = options.height ?? .42;
  addCylinder(group, basinRadius, basinRadius * 1.06, basinHeight, new THREE.Vector3(0, basinHeight / 2, 0), steel, 24);
  addCylinder(group, basinRadius * .87, basinRadius * .87, .035, new THREE.Vector3(0, basinHeight + .018, 0), waterMaterial, 24).castShadow = false;
  const legLength = options.legLength ?? 1.45;
  for (let i = 0; i < 4; i += 1) {
    const angle = i * Math.PI / 2 + Math.PI / 4;
    const leg = addBox(group, new THREE.Vector3(legLength, .11, .19), new THREE.Vector3(Math.cos(angle) * legLength * .38, .1, Math.sin(angle) * legLength * .38), darkSteel, new THREE.Euler(0, -angle, 0));
    leg.rotation.y = -angle;
    addCylinder(group, .07, .07, .08, new THREE.Vector3(Math.cos(angle) * legLength * .82, .04, Math.sin(angle) * legLength * .82), darkSteel, 10);
  }
  for (let i = 0; i < 4; i += 1) {
    const angle = i * Math.PI / 2;
    const boltPosition = new THREE.Vector3(Math.cos(angle) * basinRadius * .92, basinHeight * .62, Math.sin(angle) * basinRadius * .92);
    const bolt = addCylinder(group, .055, .055, .38, boltPosition, darkSteel, 10, new THREE.Euler(0, 0, Math.PI / 2));
    bolt.rotation.z = Math.PI / 2;
    bolt.rotation.y = -angle;
    addCylinder(group, .095, .095, .045, boltPosition.clone().add(new THREE.Vector3(Math.cos(angle) * .21, 0, Math.sin(angle) * .21)), steel, 6, new THREE.Euler(Math.PI / 2, 0, 0));
  }
  if (options.weights) {
    const weightMaterial = standardMaterial(0x5a5650, .92, 0);
    for (let i = 0; i < 4; i += 1) {
      const angle = i * Math.PI / 2 + .32;
      addBox(group, new THREE.Vector3(.66, .32, .42), new THREE.Vector3(Math.cos(angle) * 1.25, .16, Math.sin(angle) * 1.25), weightMaterial, new THREE.Euler(0, -angle, 0));
    }
  }
  return group;
}

function addGuyWires(parent, treeHeight, anchors, options = {}) {
  const wireMaterial = standardMaterial(options.color ?? 0x4f5554, .43, .78);
  const topY = options.topY ?? treeHeight * .69;
  anchors.forEach((anchor, index) => {
    const startAngle = index / anchors.length * Math.PI * 2 + .31;
    const start = new THREE.Vector3(Math.cos(startAngle) * .13, topY + signed(mulberry32(index + 2), .25), Math.sin(startAngle) * .13);
    addTube(parent, [start, start.clone().lerp(anchor, .48).add(new THREE.Vector3(0, -.08, 0)), anchor], options.radius ?? .011, wireMaterial, 16, 5);
    addCylinder(parent, .045, .045, .12, anchor.clone().add(new THREE.Vector3(0, .06, 0)), wireMaterial, 8);
  });
}

function createCrate(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const size = options.size ?? new THREE.Vector3(1.45, .82, .9);
  const timber = standardMaterial(options.color ?? 0x7b5633, .88, 0);
  const edge = standardMaterial(options.edgeColor ?? 0x4a3422, .91, 0);
  addBox(group, size, new THREE.Vector3(0, size.y / 2, 0), timber);
  const rail = .075;
  [-1, 1].forEach((sx) => {
    addBox(group, new THREE.Vector3(rail, size.y + .06, size.z + .04), new THREE.Vector3(sx * (size.x / 2 - rail / 2), size.y / 2, 0), edge);
  });
  [-1, 1].forEach((sz) => {
    addBox(group, new THREE.Vector3(size.x + .04, rail, rail), new THREE.Vector3(0, rail / 2, sz * (size.z / 2 - rail / 2)), edge);
    addBox(group, new THREE.Vector3(size.x + .04, rail, rail), new THREE.Vector3(0, size.y - rail / 2, sz * (size.z / 2 - rail / 2)), edge);
  });
  if (options.open) {
    const lid = addBox(group, new THREE.Vector3(size.x, .08, size.z), new THREE.Vector3(0, size.y + size.z * .42, -size.z * .44), timber);
    lid.rotation.x = -1.12;
  }
  if (options.label) {
    const labelMaterial = standardMaterial(0xd8cdb6, .96, 0);
    addBox(group, new THREE.Vector3(.48, .28, .015), new THREE.Vector3(0, size.y * .58, size.z / 2 + .012), labelMaterial).castShadow = false;
  }
  return group;
}

function createTrolley(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const steel = standardMaterial(0x454a49, .52, .72);
  const deck = standardMaterial(options.deckColor ?? 0x71523a, .83, 0);
  addBox(group, new THREE.Vector3(1.8, .16, .85), new THREE.Vector3(0, .42, 0), deck);
  for (const x of [-.72, .72]) for (const z of [-.3, .3]) {
    const wheel = addCylinder(group, .13, .13, .07, new THREE.Vector3(x, .17, z), steel, 14, new THREE.Euler(Math.PI / 2, 0, 0));
    wheel.rotation.x = Math.PI / 2;
  }
  const handlePoints = [new THREE.Vector3(.82,.5,0),new THREE.Vector3(1.05,1.35,0),new THREE.Vector3(.92,1.7,0)];
  addTube(group, handlePoints, .035, steel, 14, 8);
  return group;
}

function createScaffold(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const levels = options.levels ?? 3;
  const width = options.width ?? 2.25;
  const depth = options.depth ?? 1.2;
  const levelHeight = options.levelHeight ?? 1.55;
  const steel = standardMaterial(options.color ?? 0x777b79, .42, .75);
  const plank = standardMaterial(0x826344, .83, 0);
  const totalHeight = levels * levelHeight;
  for (const x of [-width / 2, width / 2]) for (const z of [-depth / 2, depth / 2]) {
    addCylinder(group, .035, .035, totalHeight, new THREE.Vector3(x, totalHeight / 2, z), steel, 8);
    addCylinder(group, .075, .075, .08, new THREE.Vector3(x, .04, z), steel, 12);
  }
  for (let level = 0; level <= levels; level += 1) {
    const y = level * levelHeight;
    for (const z of [-depth / 2, depth / 2]) cylinderBetween(group, new THREE.Vector3(-width/2,y,z), new THREE.Vector3(width/2,y,z), .025, .025, steel, 7);
    for (const x of [-width / 2, width / 2]) cylinderBetween(group, new THREE.Vector3(x,y,-depth/2), new THREE.Vector3(x,y,depth/2), .025, .025, steel, 7);
    if (level > 0) addBox(group, new THREE.Vector3(width * .9, .08, depth * .72), new THREE.Vector3(0, y + .03, 0), plank);
  }
  for (const z of [-depth/2, depth/2]) {
    cylinderBetween(group,new THREE.Vector3(-width/2,0,z),new THREE.Vector3(width/2,totalHeight,z),.018,.018,steel,6);
    cylinderBetween(group,new THREE.Vector3(width/2,0,z),new THREE.Vector3(-width/2,totalHeight,z),.018,.018,steel,6);
  }
  return group;
}

function createStepLadder(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const height = options.height ?? 2.3;
  const steel = standardMaterial(options.color ?? 0x8b9090, .42, .72);
  const feet = .78;
  const frontLeft = new THREE.Vector3(-feet/2,0,.28);
  const frontRight = new THREE.Vector3(feet/2,0,.28);
  const backLeft = new THREE.Vector3(-feet/2,0,-.45);
  const backRight = new THREE.Vector3(feet/2,0,-.45);
  const topLeft = new THREE.Vector3(-.23,height,0);
  const topRight = new THREE.Vector3(.23,height,0);
  cylinderBetween(group,frontLeft,topLeft,.035,.035,steel,7);
  cylinderBetween(group,frontRight,topRight,.035,.035,steel,7);
  cylinderBetween(group,backLeft,topLeft,.035,.035,steel,7);
  cylinderBetween(group,backRight,topRight,.035,.035,steel,7);
  for (let i = 1; i <= 6; i += 1) {
    const t = i / 7;
    const a = frontLeft.clone().lerp(topLeft,t);
    const b = frontRight.clone().lerp(topRight,t);
    cylinderBetween(group,a,b,.026,.026,steel,7);
  }
  addBox(group,new THREE.Vector3(.55,.07,.4),new THREE.Vector3(0,height,.02),steel);
  return group;
}

function createLongPole(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.set(options.rotationX ?? 0, options.rotationY ?? 0, options.rotationZ ?? 0);
  parent.add(group);
  const length = options.length ?? 4.4;
  const wood = standardMaterial(options.color ?? 0x9a744d, .8, 0);
  const iron = standardMaterial(0x494e4d, .48, .72);
  addCylinder(group, .025, .035, length, new THREE.Vector3(0,length/2,0), wood, 10);
  const hook = [new THREE.Vector3(0,length,0),new THREE.Vector3(.22,length+.06,0),new THREE.Vector3(.27,length-.15,0)];
  addTube(group,hook,.018,iron,10,6);
  return group;
}

function createSafetyBarrier(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const length = options.length ?? 3.2;
  const color = options.color ?? 0xc4a24c;
  const steel = standardMaterial(color, .48, .58);
  for (const x of [-length/2, length/2]) {
    addCylinder(group,.04,.05,1.02,new THREE.Vector3(x,.51,0),steel,10);
    addBox(group,new THREE.Vector3(.55,.06,.26),new THREE.Vector3(x,.03,0),steel);
  }
  cylinderBetween(group,new THREE.Vector3(-length/2,.82,0),new THREE.Vector3(length/2,.82,0),.028,.028,steel,8);
  cylinderBetween(group,new THREE.Vector3(-length/2,.42,0),new THREE.Vector3(length/2,.42,0),.022,.022,steel,8);
  return group;
}

function createWorker(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const scale = options.scale ?? 1;
  group.scale.setScalar(scale);
  const clothing = standardMaterial(options.clothing ?? 0x434a4b, .9, 0);
  const trousers = standardMaterial(options.trousers ?? 0x282d30, .93, 0);
  const skin = standardMaterial(options.skin ?? 0x9a6d4e, .88, 0);
  const boot = standardMaterial(0x1d1c1a, .92, 0);
  addSphere(group,.13,new THREE.Vector3(0,1.72,0),skin,14);
  addCylinder(group,.18,.23,.62,new THREE.Vector3(0,1.27,0),clothing,10);
  const armAngle = options.armRaise ?? .2;
  const leftShoulder = new THREE.Vector3(-.18,1.48,0);
  const rightShoulder = new THREE.Vector3(.18,1.48,0);
  cylinderBetween(group,leftShoulder,new THREE.Vector3(-.33,1.05 + armAngle, .06),.07,.055,clothing,8);
  cylinderBetween(group,rightShoulder,new THREE.Vector3(.33,1.05 + armAngle*1.2,-.05),.07,.055,clothing,8);
  cylinderBetween(group,new THREE.Vector3(-.1,1.0,0),new THREE.Vector3(-.14,.2,.03),.085,.065,trousers,8);
  cylinderBetween(group,new THREE.Vector3(.1,1.0,0),new THREE.Vector3(.14,.2,-.03),.085,.065,trousers,8);
  addBox(group,new THREE.Vector3(.18,.09,.34),new THREE.Vector3(-.14,.08,.1),boot);
  addBox(group,new THREE.Vector3(.18,.09,.34),new THREE.Vector3(.14,.08,.07),boot);
  if (options.hardHat) {
    const hat = standardMaterial(options.hardHatColor ?? 0xe2b84e, .55, .05);
    addSphere(group,.145,new THREE.Vector3(0,1.79,0),hat,14).scale.y=.58;
    addBox(group,new THREE.Vector3(.33,.035,.18),new THREE.Vector3(0,1.75,.06),hat);
  }
  return group;
}

function createSled(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const wood = standardMaterial(0x805431,.86,0);
  const iron = standardMaterial(0x363c3d,.45,.72);
  addBox(group,new THREE.Vector3(2.7,.12,.95),new THREE.Vector3(0,.42,0),wood);
  [-.38,.38].forEach((z) => {
    addTube(group,[new THREE.Vector3(-1.55,.08,z),new THREE.Vector3(-1.2,.02,z),new THREE.Vector3(1.45,.02,z),new THREE.Vector3(1.65,.2,z)],.035,iron,20,7);
  });
  for (const x of [-1.1,-.35,.35,1.1]) {
    addBox(group,new THREE.Vector3(.07,.45,.86),new THREE.Vector3(x,.22,0),wood);
  }
  return group;
}
