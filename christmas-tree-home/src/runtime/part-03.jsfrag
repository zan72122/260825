  addBox(group,new THREE.Vector3(.35,6.8,13),new THREE.Vector3(-8.8,3.4,0),plaster);const tokonoma=standardMaterial(0x8b7258,.88,0);addBox(group,new THREE.Vector3(4,.18,2.1),new THREE.Vector3(6,.09,-4.7),tokonoma);addBox(group,new THREE.Vector3(4,.2,.5),new THREE.Vector3(6,5.7,-5.65),timber);
  const lantern=physicalMaterial(0xe7dcbf,.88,0,{transparent:true,opacity:.82});addCylinder(group,.48,.48,1.05,new THREE.Vector3(-5.8,1.7,2.5),lantern,16);addPracticalPointLight(group,new THREE.Vector3(-5.8,1.7,2.5),0xffc98a,1.5,5,.02,false);
  return group;
}

