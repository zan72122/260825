  const plaster=standardMaterial(0xb1aa98,.96,0);addBox(group,new THREE.Vector3(18,6.8,.35),new THREE.Vector3(0,3.4,-6.2),plaster);const timber=standardMaterial(0x4d3828,.9,0);for(const x of [-8.5,-5.6,-2.8,0,2.8,5.6,8.5])addBox(group,new THREE.Vector3(.2,6.8,.4),new THREE.Vector3(x,3.4,-6),timber);for(const y of [1.8,4.2,6.4])addBox(group,new THREE.Vector3(18,.2,.4),new THREE.Vector3(0,y,-6),timber);
