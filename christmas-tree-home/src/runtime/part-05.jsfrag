  addAmbientRig(root, { sky: 0xc5d5d1, ground: 0x293330, hemi: 1.12, keyColor: 0xf4f2df, key: 2.8, keyPosition: new THREE.Vector3(-8, 15, 8), fillColor: 0x8ba8a2, fillIntensity: .62 });
  addFloorProtection(root, new THREE.Vector3(2.2, .02, -1.1), 7.7, 6.8, 0);
  const stand = createTreeStand(root, { position: new THREE.Vector3(2.2, .05, -1.1), radius: 1, legLength: 2.1, weights: true, steelColor: 0x4e5b58 });
  const tree = createFraserFir(root, { x: 2.2, z: -1.1, height: 7.8, radius: 2.75, seed: 404, density: .58, foliageColor: 0x1c4c38, foliageColor2: 0x44705a, trunkColor: 0x5a3e28, trunkCutVisible: true });
  decorateTree(tree.group, tree, { seed: 99, count: 34, ornaments: [0xd8b35b, 0xbfc9c5, 0x5c8478], ornamentSize: .1, lightColor: 0xffd38b, lightRings: 6, ribbon: false, cordColor: 0x202a27, cordRadius: .016, lightIntensity: 3.2 });
  addGuyWires(tree.group, tree.height, [new THREE.Vector3(-4.1, .1, -3.1), new THREE.Vector3(4.3, .1, -3), new THREE.Vector3(-4.1, .1, 3), new THREE.Vector3(4.3, .1, 3.1)], { topY: 5.55, radius: .016, color: 0x687572 });
  const envelopeMaterial = new THREE.MeshBasicMaterial({ color: 0xe2aa43, wireframe: true, transparent: true, opacity: .22, depthWrite: false });
  const envelope = new THREE.Mesh(new THREE.ConeGeometry(3.2, 8.2, 24, 8, true), envelopeMaterial);
  envelope.position.set(2.2, 4.15, -1.1);
  root.add(envelope);
  createScaffold(root, { position: new THREE.Vector3(6.3, 0, 1.9), rotationY: -.2, levels: 3, width: 2.1, depth: 1.15, levelHeight: 1.45, color: 0x697572 });
  addMeasurementPole(root, { position: new THREE.Vector3(-1.8, 0, -1.1), height: 8.5 });
  createCableReel(root, { position: new THREE.Vector3(-5.4, 0, 4), rotationY: .2, cable: 0x1d2724 });
  createDistributionBox(root, { position: new THREE.Vector3(-7, 0, 3.5), rotationY: .12, color: 0x4e5d59 });
  createCrate(root, { position: new THREE.Vector3(-4.2, 0, 1.2), rotationY: -.12, size: new THREE.Vector3(1.75, .86, 1.1), open: true, label: true, color: 0x6c5c45, edgeColor: 0x434038 });
  createLongPole(root, { position: new THREE.Vector3(-2.7, 0, 4.6), rotationZ: -.22, rotationY: .12, length: 4.9, color: 0x8f6e4d });
  const cablePathMaterial = standardMaterial(0xe1a93f, .46, .28);
  addTube(root, [new THREE.Vector3(-6.5, .22, 3.5), new THREE.Vector3(-2, .12, 3.2), new THREE.Vector3(.4, .14, 1.5), new THREE.Vector3(2.2, .3, -1.1)], .025, cablePathMaterial, 36, 6);
  createWorker(root, { position: new THREE.Vector3(-2.4, 0, 2.1), rotationY: .8, scale: .9, clothing: 0x445451, trousers: 0x2b3332, hardHat: true, hardHatColor: 0xe0ad45 });
  return root;
}
