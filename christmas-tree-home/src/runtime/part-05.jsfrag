function buildLaplandRaising() {
  const root = makeWorld();
  configureScene({ background: 0x4d6f82, fog: { color: 0x7893a0, density: .018 }, exposure: 1.03, cameraPosition: new THREE.Vector3(15.5, 5.2, 20.5), target: new THREE.Vector3(0, 3.2, 0), fov: 39 });
  createLaplandSnowfield(root);
  addAmbientRig(root, { sky: 0x98b7c6, ground: 0x6a7f86, hemi: 1.03, keyColor: 0xffc081, key: 2.2, keyPosition: new THREE.Vector3(-14, 5, 4), fillColor: 0x779eb5, fillIntensity: .55 });
  createSled(root, { position: new THREE.Vector3(-3.2, 0, 2.7), rotationY: .15 });
  const tree = createFraserFir(root, { x: -1.4, z: .9, height: 7.5, radius: 2.65, seed: 608, density: .82, foliageColor: 0x1d4037, foliageColor2: 0x31574a, trunkCutVisible: true });
  tree.group.rotation.z = -deg(34);
  tree.group.rotation.y = .16;
  const stand = createTreeStand(root, { position: new THREE.Vector3(2.5, .02, -.35), radius: .82, legLength: 1.5, weights: true, steelColor: 0x3f484a });
  const ropeMaterial = standardMaterial(0x8b765b, .9, 0);
  const ropeStart = new THREE.Vector3(1.35, 5.5, .2);
  const ropeEnd = new THREE.Vector3(8.5, .75, 3.5);
  addTube(root, [ropeStart, new THREE.Vector3(4.5, 3.7, 1.4), ropeEnd], .035, ropeMaterial, 28, 7);
  const secondStart = new THREE.Vector3(.8, 4.4, -.5);
  const secondEnd = new THREE.Vector3(7.3, .75, -4.2);
  addTube(root, [secondStart, new THREE.Vector3(3.7, 3.1, -2), secondEnd], .03, ropeMaterial, 25, 7);
  createWorker(root, { position: new THREE.Vector3(8.6, 0, 3.5), rotationY: -2.05, scale: .96, clothing: 0x8b3535, trousers: 0x333b42, armRaise: .55 });
  createWorker(root, { position: new THREE.Vector3(7.4, 0, -4.1), rotationY: 2.4, scale: .92, clothing: 0x314e61, trousers: 0x30373a, armRaise: .55 });
  createWorker(root, { position: new THREE.Vector3(1.1, 0, -1.5), rotationY: .5, scale: .94, clothing: 0x4a5538, trousers: 0x32393a, armRaise: .35 });
  createWorker(root, { position: new THREE.Vector3(-5.2, 0, 2.8), rotationY: 1.2, scale: .88, clothing: 0x5a3845, trousers: 0x2f3539 });
  const redMark = standardMaterial(0xbb3d35, .82, 0);
  addTube(tree.group, [new THREE.Vector3(-.25, 1.2, 0), new THREE.Vector3(.25, 1.2, 0)], .045, redMark, 8, 6);
  worldUpdate = (elapsed) => {
    const tension = Math.sin(elapsed * .8) * .0015;
    tree.group.rotation.z = -deg(34) + tension;
  };
  return root;
}

