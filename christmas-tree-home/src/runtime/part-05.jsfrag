function createCableReel(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const wood = standardMaterial(options.wood ?? 0x766047, .88, 0);
  const cable = standardMaterial(options.cable ?? 0x202725, .82, .12);
  const left = addCylinder(group, .48, .48, .08, new THREE.Vector3(-.31, .5, 0), wood, 20, new THREE.Euler(0, 0, Math.PI / 2)); left.rotation.z = Math.PI / 2;
  const right = addCylinder(group, .48, .48, .08, new THREE.Vector3(.31, .5, 0), wood, 20, new THREE.Euler(0, 0, Math.PI / 2)); right.rotation.z = Math.PI / 2;
  const core = addCylinder(group, .23, .23, .62, new THREE.Vector3(0, .5, 0), cable, 18, new THREE.Euler(0, 0, Math.PI / 2)); core.rotation.z = Math.PI / 2;
  addCylinder(group, .045, .045, 1.05, new THREE.Vector3(0, .5, 0), standardMaterial(0x444949, .42, .68), 10, new THREE.Euler(0, 0, Math.PI / 2)).rotation.z = Math.PI / 2;
  return group;
}

function createDistributionBox(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const steel = standardMaterial(options.color ?? 0x485451, .52, .58);
  addBox(group, new THREE.Vector3(.9, 1.15, .38), new THREE.Vector3(0, .58, 0), steel);
  const door = addBox(group, new THREE.Vector3(.76, .92, .035), new THREE.Vector3(0, .62, .21), standardMaterial(0x596562, .58, .5));
  door.castShadow = false;
  const colors = [0xb34a3b, 0xc4a149, 0x4e7b68, 0x3f566d];
  for (let i = 0; i < 4; i += 1) addCylinder(group, .045, .045, .03, new THREE.Vector3(-.25 + i * .17, .72, .25), standardMaterial(colors[i], .4, .2), 10, new THREE.Euler(Math.PI / 2, 0, 0));
  for (let i = 0; i < 3; i += 1) addBox(group, new THREE.Vector3(.16, .08, .04), new THREE.Vector3(-.2 + i * .2, .45, .25), standardMaterial(0x282e2d, .52, .55)).castShadow = false;
  return group;
}

function createGlassmakingBench(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const iron = standardMaterial(0x373b3c, .42, .76);
  const wood = standardMaterial(0x5e4837, .86, 0);
  addBox(group, new THREE.Vector3(4.6, .18, 1.35), new THREE.Vector3(0, 1.02, 0), wood);
  for (const x of [-2.05, 2.05]) for (const z of [-.5, .5]) addBox(group, new THREE.Vector3(.12, 1, .12), new THREE.Vector3(x, .5, z), iron);
  for (let i = 0; i < 5; i += 1) {
    const rod = addCylinder(group, .022, .022, 3.1, new THREE.Vector3(-1.55 + i * .75, 1.18, .04), iron, 8, new THREE.Euler(0, 0, Math.PI / 2));
    rod.rotation.z = Math.PI / 2;
  }
  const glassColors = [0xbd4b3d, 0xd9b557, 0x6d9792, 0xe7e4db];
  for (let i = 0; i < 8; i += 1) {
    const glass = physicalMaterial(glassColors[i % glassColors.length], .07, .02, { transmission: .26, transparent: true, opacity: .72, clearcoat: .75 });
    addSphere(group, .12 + (i % 3) * .02, new THREE.Vector3(-1.65 + (i % 4) * 1.05, 1.28, -.35 + Math.floor(i / 4) * .65), glass, 16);
  }
  return group;
}

function addCandles(parent, options = {}) {
  const origin = options.position ?? new THREE.Vector3();
  const count = options.count ?? 5;
  const wax = standardMaterial(options.wax ?? 0xe3d7bd, .82, 0);
  const holder = standardMaterial(options.holder ?? 0xa98950, .34, .72);
  for (let i = 0; i < count; i += 1) {
    const x = origin.x + (i - (count - 1) / 2) * .46;
    const h = .46 + (i % 3) * .13;
    addCylinder(parent, .045, .055, h, new THREE.Vector3(x, origin.y + h / 2, origin.z), wax, 12);
    addCylinder(parent, .1, .1, .035, new THREE.Vector3(x, origin.y + .018, origin.z), holder, 12);
    addPracticalPointLight(parent, new THREE.Vector3(x, origin.y + h + .08, origin.z), 0xff9d48, .55, 2.4, .026, true);
  }
}

function createPicnicTable(parent, options = {}) {
  const group = new THREE.Group();
  group.position.copy(options.position ?? new THREE.Vector3());
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const wood = standardMaterial(options.color ?? 0x8a6345, .84, 0);
  addBox(group, new THREE.Vector3(3.5, .12, 1.15), new THREE.Vector3(0, 1.05, 0), wood);
  addBox(group, new THREE.Vector3(3.8, .12, .42), new THREE.Vector3(0, .58, 1.05), wood);
  addBox(group, new THREE.Vector3(3.8, .12, .42), new THREE.Vector3(0, .58, -1.05), wood);
  for (const x of [-1.25, 1.25]) {
    const leg1 = addBox(group, new THREE.Vector3(.15, 1.2, .15), new THREE.Vector3(x, .55, .46), wood); leg1.rotation.x = -.26;
    const leg2 = addBox(group, new THREE.Vector3(.15, 1.2, .15), new THREE.Vector3(x, .55, -.46), wood); leg2.rotation.x = .26;
  }
  return group;
}

function addRainPuddles(parent, options = {}) {
  const random = mulberry32(options.seed ?? 321);
  const material = physicalMaterial(options.color ?? 0x4f696c, .05, 0, { transparent: true, opacity: .58, clearcoat: .8, depthWrite: false });
  for (let i = 0; i < (options.count ?? 14); i += 1) {
    const puddle = addDisc(parent, range(random, .2, .78), new THREE.Vector3(range(random, options.xMin ?? -10, options.xMax ?? 10), .017, range(random, options.zMin ?? -7, options.zMax ?? 8)), material);
    puddle.scale.set(range(random, .7, 2), range(random, .55, 1.1), 1);
    puddle.rotation.z = random() * Math.PI;
  }
}

function buildCzechGlassWorkshop() {
  const root = makeWorld();
  configureScene({ background: 0x231b17, fog: { color: 0x4f372a, density: .015 }, exposure: .93, cameraPosition: new THREE.Vector3(13.5, 5.3, 18.2), target: new THREE.Vector3(.4, 3.1, -.7), fov: 38 });
  createGlassWorkshop(root);
  addAmbientRig(root, { sky: 0x544c49, ground: 0x2b211b, hemi: .53, keyColor: 0xff7b35, key: 2.4, keyPosition: new THREE.Vector3(8, 6, -2), fillColor: 0x69808d, fillIntensity: .25 });
  const stand = createTreeStand(root, { position: new THREE.Vector3(1.3, .02, -2), radius: .62, legLength: 1.2, weights: false, steelColor: 0x414747 });
  const tree = createFraserFir(root, { x: 1.3, z: -2, height: 5.2, radius: 1.95, seed: 80, density: .83, foliageColor: 0x173a2b, foliageColor2: 0x2b513c });
  decorateTree(tree.group, tree, { seed: 811, count: 45, ornaments: [0xb83e36, 0xd5ae50, 0x6a9190, 0xd9e0dc], ornamentSize: .115, lightColor: 0xffbf72, lightRings: 4, ribbon: false });
  addTreeTopper(tree.group, tree, { color: 0xd2a444, size: .42, metalness: .55 });
  createGlassmakingBench(root, { position: new THREE.Vector3(-4.5, 0, 3.8), rotationY: .12 });
  createCrate(root, { position: new THREE.Vector3(-7.5, 0, 1.2), rotationY: .3, size: new THREE.Vector3(1.9, .95, 1.15), open: true, color: 0x60442d, edgeColor: 0x3f2d20 });
  createWorker(root, { position: new THREE.Vector3(6.2, 0, -.6), rotationY: -1.3, scale: .9, clothing: 0x4a3429, trousers: 0x2c2927, armRaise: .5 });
  const iron = standardMaterial(0x333738, .4, .75);
  const blowPipe = addCylinder(root, .022, .022, 3.8, new THREE.Vector3(5.55, 1.28, -.5), iron, 8, new THREE.Euler(0, 0, Math.PI / 2)); blowPipe.rotation.z = Math.PI / 2;
  const moltenGlass = physicalMaterial(0xff7b2a, .08, 0, { emissive: 0xff4b12, emissiveIntensity: 3, transparent: true, opacity: .9 });
  addSphere(root, .17, new THREE.Vector3(3.65, 1.28, -.5), moltenGlass, 18);
  return root;
}

