function buildTechnicalCutaway() {
  const root = makeWorld();
  configureScene({ background: 0x1e2927, fog: { color: 0x34403e, density: .008 }, exposure: 1.06, cameraPosition: new THREE.Vector3(16.5, 7.6, 21), target: new THREE.Vector3(1.2, 4.2, -1), fov: 35 });
