function updateCopy(variant, index) {
  document.body.dataset.ui = variant.ui;
  sceneNumber.textContent = `${String(index + 1).padStart(2, '0')} / ${String(variants.length).padStart(2, '0')}`;
  scenePlace.textContent = variant.place;
  sceneKicker.textContent = variant.kicker;
  sceneTitle.textContent = variant.title;
  sceneDescription.textContent = variant.description;
  materialCaption.textContent = variant.materials;
  startOverline.textContent = variant.startOverline;
  startLabel.textContent = variant.startLabel;
  startModalCopy.textContent = variant.startModalCopy;
  variantDots.querySelectorAll('.variant-dot').forEach((dot, dotIndex) => {
    dot.setAttribute('aria-selected', String(dotIndex === index));
    dot.tabIndex = dotIndex === index ? 0 : -1;
  });
}

function createVariantDots() {
  variants.forEach((variant, index) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'variant-dot';
    button.setAttribute('role', 'tab');
    button.setAttribute('aria-label', `${index + 1}: ${variant.title}`);
    button.setAttribute('aria-selected', String(index === 0));
    button.tabIndex = index === 0 ? 0 : -1;
    button.innerHTML = `<span>${variant.title}</span>`;
    button.addEventListener('click', () => switchVariant(index, index > activeVariantIndex ? 1 : -1));
    variantDots.appendChild(button);
  });
}

function buildVariant(index) {
  worldUpdate = null;
  const variant = variants[index];
  const newRoot = variant.build();
  scene.add(newRoot);
  const previousRoot = activeRoot;
  activeRoot = newRoot;
  if (previousRoot && previousRoot !== newRoot) disposeWorld(previousRoot);
  updateCopy(variant, index);
  camera.lookAt(cameraTarget);
  renderer.render(scene, camera);
}

function switchVariant(requestedIndex, direction = 1) {
  if (switching || variants.length === 0) return;
  const nextIndex = (requestedIndex + variants.length) % variants.length;
  if (nextIndex === activeVariantIndex && app.classList.contains('is-ready')) return;
  switching = true;
  copyPanel.classList.add('is-switching');
  playTone(direction >= 0 ? 560 : 470, .075, .025);
  window.setTimeout(() => {
    activeVariantIndex = nextIndex;
    try {
      buildVariant(activeVariantIndex);
    } catch (error) {
      console.error(`Scene ${activeVariantIndex + 1} failed:`, error);
      announce('この会場を組み立て直しています');
    }
    requestAnimationFrame(() => {
      copyPanel.classList.remove('is-switching');
      switching = false;
    });
  }, reducedMotion ? 0 : 135);
}

function openModal(modal) {
  modal.hidden = false;
  const focusTarget = modal.querySelector('button');
  requestAnimationFrame(() => focusTarget?.focus({ preventScroll: true }));
  playTone(620, .1, .032);
}

function closeModal(modal) {
  modal.hidden = true;
  playTone(430, .07, .022);
}

function setupInterface() {
  createVariantDots();
  previousButton.addEventListener('click', () => switchVariant(activeVariantIndex - 1, -1));
  nextButton.addEventListener('click', () => switchVariant(activeVariantIndex + 1, 1));
  startButton.addEventListener('click', () => openModal(startModal));
  infoButton.addEventListener('click', () => openModal(infoModal));
  soundButton.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    soundButton.setAttribute('aria-pressed', String(soundEnabled));
    if (soundEnabled) {
      unlockAudio();
      playTone(660, .13, .035);
      announce('操作音をオンにしました');
    } else {
      announce('操作音をオフにしました');
    }
  });
  document.querySelectorAll('[data-close-modal]').forEach((element) => {
    element.addEventListener('click', () => {
      const modal = element.closest('.modal');
      if (modal) closeModal(modal);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') switchVariant(activeVariantIndex - 1, -1);
    if (event.key === 'ArrowRight') switchVariant(activeVariantIndex + 1, 1);
    if (event.key === 'Escape') {
      if (!infoModal.hidden) closeModal(infoModal);
      if (!startModal.hidden) closeModal(startModal);
    }
  });
}

function normalizedPointer(event) {
  return {
    x: event.clientX / Math.max(1, window.innerWidth) * 2 - 1,
    y: event.clientY / Math.max(1, window.innerHeight) * 2 - 1,
  };
}

canvas.addEventListener('pointerdown', (event) => {
  pointerDown = true;
  pointerMoved = false;
  pointerStartX = pointerLastX = event.clientX;
  pointerStartY = pointerLastY = event.clientY;
  canvas.setPointerCapture?.(event.pointerId);
}, { passive: true });

canvas.addEventListener('pointermove', (event) => {
  const normalized = normalizedPointer(event);
  targetParallaxX = clamp(normalized.x, -1, 1);
  targetParallaxY = clamp(normalized.y, -1, 1);
  if (!pointerDown) return;
  pointerLastX = event.clientX;
  pointerLastY = event.clientY;
  if (Math.hypot(pointerLastX - pointerStartX, pointerLastY - pointerStartY) > 7) pointerMoved = true;
}, { passive: true });

canvas.addEventListener('pointerup', (event) => {
  if (!pointerDown) return;
  pointerDown = false;
  const deltaX = event.clientX - pointerStartX;
  const deltaY = event.clientY - pointerStartY;
  const threshold = isCoarsePointer ? 28 : 42;
  if (Math.abs(deltaX) >= threshold && Math.abs(deltaX) > Math.abs(deltaY) * .78) {
    switchVariant(activeVariantIndex + (deltaX < 0 ? 1 : -1), deltaX < 0 ? 1 : -1);
  }
  canvas.releasePointerCapture?.(event.pointerId);
}, { passive: true });

canvas.addEventListener('pointercancel', () => { pointerDown = false; }, { passive: true });
canvas.addEventListener('pointerleave', () => {
  if (!pointerDown) {
    targetParallaxX = 0;
    targetParallaxY = 0;
  }
}, { passive: true });

function renderFrame() {
  const elapsed = clock.getElapsedTime();
  parallaxX = lerp(parallaxX, targetParallaxX, reducedMotion ? .22 : .055);
  parallaxY = lerp(parallaxY, targetParallaxY, reducedMotion ? .22 : .055);

  const portraitFactor = clamp((.9 - camera.aspect) / .55, 0, 1);
  const distanceScale = 1 + portraitFactor * .35;
  tmpVecA.copy(baseCameraPosition).sub(cameraTarget).multiplyScalar(distanceScale).add(cameraTarget);
  tmpVecA.x += parallaxX * (reducedMotion ? .06 : .42);
  tmpVecA.y += -parallaxY * (reducedMotion ? .04 : .26) + portraitFactor * .32;
  tmpVecA.z += parallaxX * (reducedMotion ? .02 : .11);
  desiredCameraPosition.copy(tmpVecA);
  camera.position.lerp(desiredCameraPosition, reducedMotion ? .2 : .065);
  tmpVecB.copy(cameraTarget);
  tmpVecB.x += parallaxX * (reducedMotion ? .015 : .14);
  tmpVecB.y += -parallaxY * (reducedMotion ? .01 : .08);
  camera.lookAt(tmpVecB);

  if (worldUpdate) worldUpdate(elapsed);
  renderer.render(scene, camera);
}

setupInterface();
buildVariant(0);
renderer.setAnimationLoop(renderFrame);
requestAnimationFrame(() => {
  app.classList.add('is-ready');
  app.setAttribute('aria-busy', 'false');
  staticFallback.setAttribute('aria-hidden', 'true');
});
