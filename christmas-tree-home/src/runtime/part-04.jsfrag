}

function buildOaxacaCourtyard() {
  const root = makeWorld();
  configureScene({ background: 0x6a5050, fog: { color: 0x8a6155, density: .009 }, exposure: 1.06, cameraPosition: new THREE.Vector3(14.5, 5.8, 19.5), target: new THREE.Vector3(0, 3.2, -1.5), fov: 39 });
  createOaxacaCourtyard(root);
  addAmbientRig(root, { sky: 0xc97c5f, ground: 0x4d3028, hemi: .98, keyColor: 0xffb36b, key: 3.2, keyPosition: new THREE.Vector3(-11, 9, 8), fillColor: 0x655a8b, fillIntensity: .42 });
  const stand = createTreeStand(root, { position: new THREE.Vector3(0, .02, -1.5), radius: .68, legLength: 1.25, weights: true, steelColor: 0x4d4a43 });
  const tree = createFraserFir(root, { x: 0, z: -1.5, height: 5.6, radius: 2.1, seed: 702, density: .96, foliageColor: 0x1d4b36, foliageColor2: 0x3a694a });
  decorateTree(tree.group, tree, { seed: 61, count: 54, ornaments: [0xd0483a, 0xe1ad35, 0x2e8579, 0x3e5791, 0xd86b91], ornamentSize: .105, lightColor: 0xffbf72, lightRings: 5, ribbon: true, ribbonColor: 0xd6513e, ribbonWidth: .035 });
  addTreeTopper(tree.group, tree, { color: 0xd8a43f, size: .46, metalness: .32 });
  for (let i = 0; i < 16; i += 1) {
    const p = tree.ornamentAnchors[(i * 5 + 2) % tree.ornamentAnchors.length];
    const star = new THREE.Mesh(createStarGeometry(8, .15, .075, .025), physicalMaterial(i % 2 ? 0xc66d36 : 0xb8a45b, .36, .45));
    star.position.copy(p); star.rotation.y = i * .6; star.castShadow = true; tree.group.add(star);
  }
  createCrate(root, { position: new THREE.Vector3(-4.6, 0, 3.8), rotationY: .25, size: new THREE.Vector3(1.7, .85, 1.1), open: true, color: 0x815036, edgeColor: 0x573423 });
  createOrnamentTray(root, { position: new THREE.Vector3(-4.55, .88, 3.75), rotationY: .25, seed: 45, palette: [0xd54a3c, 0xe1aa31, 0x2f8274, 0x365894], felt: 0x6f2b32 });
  addWrappedBoxes(root, { position: new THREE.Vector3(1.2, 0, .65), count: 7, seed: 33, colors: [0xc04438, 0x2d8378, 0xe1aa32, 0x3e5690] });
  return root;
}
