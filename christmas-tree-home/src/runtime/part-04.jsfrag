function buildOkinawaTerrace() {
  const root = makeWorld();
  configureScene({ background: 0x856f62, fog: { color: 0x9d8576, density: .009 }, exposure: 1.08, cameraPosition: new THREE.Vector3(15.8, 6.1, 20.5), target: new THREE.Vector3(1.2, 3.7, -2.6), fov: 37 });
  createOkinawaTerrace(root);
  addAmbientRig(root, { sky: 0xd6a77f, ground: 0x3e4d49, hemi: 1.05, keyColor: 0xffb56e, key: 3.6, keyPosition: new THREE.Vector3(-12, 8, 2), fillColor: 0x72a4ad, fillIntensity: .65 });
  const stand = createTreeStand(root, { position: new THREE.Vector3(1.2, .025, -2.7), radius: 1.05, legLength: 2.2, weights: true, steelColor: 0x4f5b5b });
  const tree = createFraserFir(root, { x: 1.2, z: -2.7, height: 6.4, radius: 2.45, seed: 905, density: .86, foliageColor: 0x164332, foliageColor2: 0x2e6048, branchColor: 0x374234 });
  decorateTree(tree.group, tree, { seed: 51, count: 58, ornaments: [0xe1b04f, 0xd66f52, 0x4c8e92, 0xe7dec2], ornamentSize: .12, lightColor: 0xffcf8a, lightRings: 6, cordColor: 0x233834, cordRadius: .015, ribbon: true, ribbonColor: 0xd48654, ribbonWidth: .04 });
  addTreeTopper(tree.group, tree, { color: 0xd9a347, size: .52, metalness: .45 });
  const anchors = [new THREE.Vector3(-4.3, .08, -3.4), new THREE.Vector3(4.4, .08, -3.3), new THREE.Vector3(-4, .08, 3.3), new THREE.Vector3(4.3, .08, 3.1)];
  addGuyWires(tree.group, tree.height, anchors, { topY: 4.6, radius: .015, color: 0x505c5b });
  createCrate(root, { position: new THREE.Vector3(-5.1, 0, 3.4), rotationY: .18, size: new THREE.Vector3(1.8, .92, 1.15), open: true, color: 0x6f5a42, edgeColor: 0x4b4034 });
  createTrolley(root, { position: new THREE.Vector3(-7.2, 0, 2.3), rotationY: .42, deckColor: 0x5b625e });
  createSafetyBarrier(root, { position: new THREE.Vector3(1, 0, 2.8), length: 7.4, color: 0x6e7774 });
  const windRibbon = standardMaterial(0xeeaf5f, .76, 0, { side: THREE.DoubleSide });
  const ribbonPoints = [new THREE.Vector3(-8, 4.9, -5.5), new THREE.Vector3(-6.6, 4.7, -5.2), new THREE.Vector3(-5.1, 4.85, -5.5)];
  addTube(root, ribbonPoints, .035, windRibbon, 18, 5);
  worldUpdate = (elapsed) => {
    const sway = Math.sin(elapsed * 1.45) * .0035 + Math.sin(elapsed * .47) * .002;
    tree.group.rotation.z = sway;
  };
  return root;
}

function buildHelsinkiLivingRoom() {
  const root = makeWorld();
  configureScene({ background: 0x9fa29f, fog: { color: 0xaaa9a2, density: .005 }, exposure: 1.03, cameraPosition: new THREE.Vector3(10.8, 4.2, 14), target: new THREE.Vector3(1.3, 2.1, -.7), fov: 40 });
