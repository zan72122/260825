  addTreeTopper(tree.group, tree, { color: 0xd7c99e, size: .29, metalness: .02, offsetY: .34 });
  for (let i = 0; i < 16; i += 1) createPaperOrnament(tree.group, tree.ornamentAnchors[(i * 3) % tree.ornamentAnchors.length], i % 2 ? 0xd8c99e : 0xb44a3f, .34);
  createStepLadder(root, { position: new THREE.Vector3(5.2, 0, .35), rotationY: -.45, height: 1.25, color: 0x6e675d });
  createOrnamentTray(root, { position: new THREE.Vector3(1.1, .03, 2.45), rotationY: -.12, seed: 8, palette: [0xa34038, 0xc2ab72, 0xe0d3b9], wood: 0x82694f, felt: 0x7b6e5b });
