function buildGround(parent, config, registry) {
  const lawnMap=makeLawnTexture(registry,41+Number(config.number),[10,10],config.grass);
  const lawn=material(0xffffff,.96,0,{map:lawnMap});
  addPlane(parent,34,34,[0,0,-4],lawn);
  const pathMap=makeStoneTexture(registry,71+Number(config.number),[2.2,8],config.path);
  const path=material(0xffffff,config.wet?.28:.93,0,{map:pathMap});
  addPlane(parent,3.45,25,[0,.012,-3.9],path);
  if(config.wet) {
    const puddle=material(0x779394,.08,.04,{transparent:true,opacity:.24,depthWrite:false});
