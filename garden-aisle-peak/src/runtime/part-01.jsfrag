
/* ===== CORE.JS ===== */
const THREE = globalThis.__GARDEN_PEAK_THREE__;


const Y_AXIS = new THREE.Vector3(0, 1, 0);
const Z_AXIS = new THREE.Vector3(0, 0, 1);

function seeded(seed = 1) {
  let value = seed >>> 0;
  return () => {
    value += 0x6D2B79F5;
    let t = value;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

class TextureRegistry {
  constructor() { this.items = []; }
  add(texture) { this.items.push(texture); return texture; }
  dispose() { this.items.forEach((texture) => texture.dispose()); this.items = []; }
}

function canvasTexture(registry, size, painter, repeat = [1, 1]) {
  const canvas = document.createElement('canvas');
  canvas.width = size;
  canvas.height = size;
  const context = canvas.getContext('2d');
  painter(context, size);
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.wrapS = texture.wrapT = THREE.RepeatWrapping;
  texture.repeat.set(...repeat);
  texture.anisotropy = 4;
  return registry.add(texture);
}

function makeStoneTexture(registry, seed = 1, repeat = [5, 8], tint = '#a9a08f') {
  const rand = seeded(seed);
  return canvasTexture(registry, 512, (ctx, size) => {
    ctx.fillStyle = tint;
    ctx.fillRect(0, 0, size, size);
    for (let i = 0; i < 4200; i++) {
      const value = 70 + Math.floor(rand() * 115);
      const alpha = .018 + rand() * .09;
      ctx.fillStyle = `rgba(${value},${Math.max(0, value - 4)},${Math.max(0, value - 11)},${alpha})`;
      const radius = .4 + rand() * 2.8;
      ctx.fillRect(rand() * size, rand() * size, radius, radius);
    }
    ctx.strokeStyle = 'rgba(57,52,44,.13)';
    ctx.lineWidth = 2;
    for (let row = 0; row <= 12; row++) {
      const y = row * size / 12;
      ctx.beginPath();
      ctx.moveTo(0, y + (rand() - .5) * 3);
      ctx.lineTo(size, y + (rand() - .5) * 3);
      ctx.stroke();
    }
  }, repeat);
}

function makeWoodTexture(registry, seed = 2, repeat = [3, 1], tint = '#795b42') {
  const rand = seeded(seed);
  return canvasTexture(registry, 512, (ctx, size) => {
    ctx.fillStyle = tint;
    ctx.fillRect(0, 0, size, size);
    for (let i = 0; i < 170; i++) {
      const y = rand() * size;
      ctx.strokeStyle = `rgba(${35 + rand() * 65},${22 + rand() * 38},${13 + rand() * 24},${.055 + rand() * .16})`;
      ctx.lineWidth = .6 + rand() * 2.4;
      ctx.beginPath();
      ctx.moveTo(0, y);
      for (let x = 0; x <= size; x += 24) {
        ctx.lineTo(x, y + Math.sin(x * .022 + rand() * 2.8) * (1.2 + rand() * 4.5));
      }
      ctx.stroke();
    }
    for (let i = 0; i < 7; i++) {
      ctx.strokeStyle = 'rgba(34,23,16,.2)';
      ctx.beginPath();
      ctx.ellipse(rand() * size, rand() * size, 16 + rand() * 35, 4 + rand() * 9, rand() * .3, 0, Math.PI * 2);
      ctx.stroke();
    }
  }, repeat);
}

function makeLawnTexture(registry, seed = 3, repeat = [9, 9], tint = '#56694a') {
  const rand = seeded(seed);
  return canvasTexture(registry, 512, (ctx, size) => {
    ctx.fillStyle = tint;
    ctx.fillRect(0, 0, size, size);
    for (let i = 0; i < 9500; i++) {
      const alpha = .025 + rand() * .07;
      const light = rand() > .5 ? 230 : 20;
      ctx.strokeStyle = `rgba(${light},${light},${Math.max(0, light - 8)},${alpha})`;
      const x = rand() * size;
      const y = rand() * size;
      ctx.beginPath();
      ctx.moveTo(x, y + 2 + rand() * 5);
      ctx.lineTo(x + (rand() - .5) * 2, y);
      ctx.stroke();
    }
  }, repeat);
}

function material(color, roughness = .78, metalness = 0, options = {}) {
  return new THREE.MeshStandardMaterial({
    color,
    roughness,
    metalness,
    map: options.map ?? null,
    side: options.side ?? THREE.FrontSide,
    transparent: options.transparent ?? false,
    opacity: options.opacity ?? 1,
    depthWrite: options.depthWrite ?? true,
    emissive: options.emissive ?? 0x000000,
    emissiveIntensity: options.emissiveIntensity ?? 0,
    vertexColors: options.vertexColors ?? false
  });
}

function addMesh(parent, geometry, mat, position = [0, 0, 0], rotation = [0, 0, 0], scale = [1, 1, 1], shadows = true) {
  const mesh = new THREE.Mesh(geometry, mat);
  mesh.position.set(...position);
  mesh.rotation.set(...rotation);
  mesh.scale.set(...scale);
  mesh.castShadow = shadows;
  mesh.receiveShadow = shadows;
  parent.add(mesh);
  return mesh;
}

function addBox(parent, size, position, mat, rotation = [0, 0, 0], shadows = true) {
  return addMesh(parent, new THREE.BoxGeometry(...size), mat, position, rotation, [1, 1, 1], shadows);
}

function addCylinder(parent, radiusTop, radiusBottom, height, position, mat, radial = 18, rotation = [0, 0, 0], shadows = true) {
  return addMesh(parent, new THREE.CylinderGeometry(radiusTop, radiusBottom, height, radial, 1, false), mat, position, rotation, [1, 1, 1], shadows);
}

function addSphere(parent, radius, position, mat, scale = [1, 1, 1], segments = 12, shadows = true) {
  return addMesh(parent, new THREE.SphereGeometry(radius, segments, Math.max(7, Math.floor(segments * .65))), mat, position, [0, 0, 0], scale, shadows);
}

function addPlane(parent, width, depth, position, mat, rotation = [-Math.PI / 2, 0, 0], shadows = true) {
  return addMesh(parent, new THREE.PlaneGeometry(width, depth), mat, position, rotation, [1, 1, 1], shadows);
}

function cylinderBetween(parent, start, end, radius, mat, radial = 10, shadows = true) {
  const a = new THREE.Vector3(...start);
  const b = new THREE.Vector3(...end);
  const direction = b.clone().sub(a);
  const length = direction.length();
  if (length < .0001) return null;
  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, length, radial), mat);
  mesh.position.copy(a).add(b).multiplyScalar(.5);
  mesh.quaternion.setFromUnitVectors(Y_AXIS, direction.normalize());
  mesh.castShadow = shadows;
  mesh.receiveShadow = shadows;
  parent.add(mesh);
  return mesh;
}

function addRing(parent, center, radius, tube, mat, rotation = [0, 0, 0], arc = Math.PI * 2) {
  const geometry = new THREE.TorusGeometry(radius, tube, 8, 48, arc);
  return addMesh(parent, geometry, mat, center, rotation);
}

function disposeObject(object) {
  object.traverse((child) => {
    if (!child.isMesh && !child.isLine && !child.isPoints) return;
    child.geometry?.dispose?.();
    const mats = Array.isArray(child.material) ? child.material : [child.material];
    mats.filter(Boolean).forEach((entry) => entry.dispose?.());
  });
}

function orientObject(object, direction, localAxis = Y_AXIS) {
  object.quaternion.setFromUnitVectors(localAxis, direction.clone().normalize());
  return object;
}

function chairLeg(parent, x, y, z, height, mat, radius = .025) {
  addCylinder(parent, radius, radius * 1.08, height, [x, y + height / 2, z], mat, 8);
}

function buildChair(parent, position, rotationY = Math.PI, options = {}) {
  const kind = options.kind ?? 'crossback';
  const color = options.color ?? 0x76583e;
  const group = new THREE.Group();
  group.position.set(...position);
  group.rotation.y = rotationY;
  parent.add(group);
  const wood = material(color, kind === 'chiavari' ? .52 : .82, kind === 'chiavari' ? .18 : 0);
  const seat = material(options.seat ?? 0xc7b9a7, .92);

  if (kind === 'bench') {
    addBox(group, [1.95, .11, .44], [0, .57, 0], wood);
    addBox(group, [1.95, .1, .18], [0, 1.05, -.18], wood);
    [-.78, .78].forEach((x) => {
      addBox(group, [.09, .62, .09], [x, .31, 0], wood);
      addBox(group, [.09, .64, .08], [x, .85, -.18], wood);
    });
    return group;
  }

  if (kind === 'stool') {
    addCylinder(group, .24, .25, .07, [0, .58, 0], seat, 24);
    [-.17, .17].forEach((x) => [-.12, .12].forEach((z) => chairLeg(group, x, 0, z, .57, wood, .025)));
    return group;
  }

  addBox(group, [.62, .09, .52], [0, .62, 0], seat);
  [-.25, .25].forEach((x) => {
    [-.19, .19].forEach((z) => chairLeg(group, x, 0, z, .62, wood, kind === 'bamboo' ? .035 : .024));
    chairLeg(group, x, .6, -.2, .74, wood, kind === 'bamboo' ? .036 : .025);
  });

  if (kind === 'crossback') {
    cylinderBetween(group, [-.25, .76, -.2], [.25, 1.28, -.2], .025, wood, 8);
    cylinderBetween(group, [.25, .76, -.2], [-.25, 1.28, -.2], .025, wood, 8);
    addCylinder(group, .026, .026, .55, [0, 1.04, -.2], wood, 8, [0, 0, Math.PI / 2]);
  } else if (kind === 'chiavari') {
