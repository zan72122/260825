  handle.rotation.z = Math.PI;
  return group;
}

function buildWateringCan(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const metal = material(options.color ?? 0x68716e, .36, .58);
  addCylinder(group, .27, .29, .48, [0, .24, 0], metal, 22);
  cylinderBetween(group, [.2,.37,0],[.75,.62,0],.055,metal,10);
  addCylinder(group, .12, .055, .15, [.82, .65, 0], metal, 18, [0,0,-Math.PI/2]);
  addRing(group, [-.23,.48,0], .3, .035, metal, [Math.PI/2,0,0], Math.PI * 1.15);
  return group;
}

function buildRoadCase(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const body = material(options.color ?? 0x2d3130, .52, .26);
  const edge = material(0x8b8e89, .28, .72);
  addBox(group, [1.35, .75, .82], [0, .375, 0], body);
  [-.64,.64].forEach((x) => addBox(group,[.045,.79,.87],[x,.39,0],edge));
  [-.38,.38].forEach((y) => addBox(group,[1.39,.045,.87],[0,.38+y,0],edge));
  [-.38,.38].forEach((x) => [-.23,.23].forEach((z) => addCylinder(group,.07,.07,.055,[x,.035,z],edge,12,[Math.PI/2,0,0])));
  return group;
}

function buildTrolley(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const metal = material(options.color ?? 0x545a58, .32, .67);
  addBox(group, [1.45, .08, .75], [0, .34, 0], metal);
  addBox(group, [1.45, .08, .75], [0, 1.05, 0], metal);
  [-.64,.64].forEach((x) => [-.29,.29].forEach((z) => addBox(group,[.045,.72,.045],[x,.7,z],metal)));
  [-.57,.57].forEach((x) => [-.25,.25].forEach((z) => addCylinder(group,.1,.1,.07,[x,.08,z],material(0x252726,.82),14,[Math.PI/2,0,0])));
  cylinderBetween(group,[.67,1.05,0],[.92,1.42,0],.035,metal,8);
  return group;
}

function buildLadder(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  group.rotation.y = options.rotationY ?? 0;
  parent.add(group);
  const aluminum = material(0x8e9694, .24, .76);
  const h = options.height ?? 2.4;
  [-.28,.28].forEach((x) => addBox(group,[.065,h,.08],[x,h/2,0],aluminum,[0,0,x<0?-.08:.08]));
  for(let y=.25;y<h-.1;y+=.32) addBox(group,[.58,.045,.11],[0,y,0],aluminum);
  return group;
}

function buildFireExtinguisher(parent, position) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const red = material(0xa62f2f, .43, .08);
  const black = material(0x222423, .6, .15);
  addCylinder(group,.13,.15,.48,[0,.24,0],red,18);
  addBox(group,[.18,.08,.08],[0,.52,0],black);
  cylinderBetween(group,[.07,.5,0],[.28,.67,.03],.025,black,7);
  return group;
}

function buildCopperBowl(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const copper = material(options.color ?? 0x9e5e38, .3, .72);
  addCylinder(group,.46,.3,.32,[0,.16,0],copper,28);
  addCylinder(group,.5,.47,.055,[0,.34,0],copper,28);
  return group;
}

function buildShallowBasin(parent, position, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const stone = material(options.color ?? 0x373a37, .66, .08);
  const water = material(options.water ?? 0x455a5b, .06, .08, { transparent: true, opacity: .72, depthWrite: false });
  addCylinder(group,.72,.78,.12,[0,.06,0],stone,32);
  addCylinder(group,.66,.66,.025,[0,.13,0],water,32);
  return group;
}

function addGroundPetals(parent, options = {}) {
  const rand = seeded(options.seed ?? 1);
  const count = options.count ?? 90;
  const colors = options.colors ?? [0xf0d9d7,0xf5eee5];
  const geometry = new THREE.SphereGeometry(.07, 6, 4);
  const groups = colors.map(() => []);
  const dummy = new THREE.Object3D();
  for (let i=0;i<count;i++) {
    const z = (rand() - .5) * (options.length ?? 17) + (options.z ?? -1);
    const x = (rand() - .5) * (options.width ?? 2.4);
    dummy.position.set(x,.028 + rand()*.012,z);
    dummy.rotation.set(rand()*.4,rand()*Math.PI,rand()*Math.PI);
    dummy.scale.set(.8+rand()*.8,.12,.4+rand()*.9);
    dummy.updateMatrix();
    groups[i % colors.length].push(dummy.matrix.clone());
  }
  groups.forEach((matrices,index) => {
    const mesh = new THREE.InstancedMesh(geometry,material(colors[index],.88),matrices.length);
    matrices.forEach((matrix,i)=>mesh.setMatrixAt(i,matrix));
    mesh.instanceMatrix.needsUpdate=true;
    mesh.receiveShadow=true;
    parent.add(mesh);
  });
}

/* ===== FLOWERS.JS ===== */
const LEAF_GEOMETRY = (() => {
  const geometry = new THREE.BufferGeometry();
  const vertices = new Float32Array([
    0, .58, .01,  -.23, .08, 0,  0, -.58, -.01,
    0, .58, .01,   0, -.58, -.01, .23, .08, 0,
    0, .58, .01,   0, .04, .055, -.23, .08, 0,
    0, .58, .01,   .23, .08, 0, 0, .04, .055,
    0, -.58, -.01, -.23, .08, 0, 0, .04, .055,
    0, -.58, -.01, 0, .04, .055, .23, .08, 0
  ]);
  geometry.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
  geometry.computeVertexNormals();
  return geometry;
})();

const HEART_GEOMETRY = (() => {
  const shape = new THREE.Shape();
  shape.moveTo(0, -.58);
  shape.bezierCurveTo(-.52, -.24, -.62, .26, -.28, .52);
  shape.bezierCurveTo(-.08, .67, 0, .49, 0, .31);
  shape.bezierCurveTo(0, .49, .08, .67, .28, .52);
  shape.bezierCurveTo(.62, .26, .52, -.24, 0, -.58);
  const geometry = new THREE.ShapeGeometry(shape, 10);
  geometry.computeVertexNormals();
  return geometry;
})();

const PETAL = new THREE.SphereGeometry(1, 7, 5);
const PETAL_FINE = new THREE.SphereGeometry(1, 8, 6);
const CENTER = new THREE.IcosahedronGeometry(1, 1);
const BEAD = new THREE.SphereGeometry(1, 6, 4);
const STEM = new THREE.CylinderGeometry(1, 1, 1, 7);
const SPIRE = new THREE.CylinderGeometry(.46, .72, 1, 10);
const TULIP_PETAL = new THREE.SphereGeometry(1, 8, 6, 0, Math.PI * 2, 0, Math.PI * .56);

function colorKey(color) {
  return typeof color === 'number' ? color.toString(16) : String(color);
}

function qFromNormal(normal, axis = Z_AXIS) {
  return new THREE.Quaternion().setFromUnitVectors(axis, normal.clone().normalize());
}

class FloralBatch {
  constructor(options = {}) {
    this.rand = seeded(options.seed ?? 1);
    this.leafColors = options.leafColors ?? [0x426044, 0x6f8261];
    this.stemColor = options.stemColor ?? this.leafColors[0];
    this.instances = new Map();
  }

  queue(geometryName, geometry, color, position, quaternion = new THREE.Quaternion(), scale = new THREE.Vector3(1,1,1), options = {}) {
    const key = `${geometryName}|${colorKey(color)}|${options.roughness ?? .82}|${options.metalness ?? 0}|${options.side ?? 'front'}|${options.emissive ?? 0}`;
    if (!this.instances.has(key)) this.instances.set(key, { geometry, color, matrices: [], options });
    const dummy = new THREE.Object3D();
    dummy.position.copy(position);
    dummy.quaternion.copy(quaternion);
    dummy.scale.copy(scale);
    dummy.updateMatrix();
    this.instances.get(key).matrices.push(dummy.matrix.clone());
  }

  stem(start, end, radius = .012, color = this.stemColor) {
    const a = start.clone();
    const b = end.clone();
    const direction = b.clone().sub(a);
    const length = direction.length();
    if (length < .001) return;
    const q = new THREE.Quaternion().setFromUnitVectors(Y_AXIS, direction.normalize());
    this.queue('stem', STEM, color, a.add(b).multiplyScalar(.5), q, new THREE.Vector3(radius, length, radius), { roughness: .93 });
  }

  branch(start, end, radius = .025, color = 0x594636) {
    this.stem(start, end, radius, color);
  }

  leaf(position, size = .32, colorIndex = 0, normal = new THREE.Vector3(0,.3,1), roll = 0, width = .72) {
    const q = qFromNormal(normal);
    q.multiply(new THREE.Quaternion().setFromAxisAngle(Z_AXIS, roll));
    this.queue('leaf', LEAF_GEOMETRY, this.leafColors[colorIndex % this.leafColors.length], position, q, new THREE.Vector3(size * width, size, size), { roughness: .9, side: THREE.DoubleSide });
  }

  broadLeaf(position, size = .75, colorIndex = 0, normal = new THREE.Vector3(0,.2,1), roll = 0) {
    const q = qFromNormal(normal);
    q.multiply(new THREE.Quaternion().setFromAxisAngle(Z_AXIS, roll));
