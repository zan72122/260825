      const a = .02 + rand() * .04;
      ctx.fillStyle = `rgba(255,245,225,${a})`;
      ctx.fillRect(rand() * size, rand() * size, 1, 1);
    }
  }, repeatX, repeatY);
}

function makeStoneTexture(seed = 2, repeatX = 4, repeatY = 4) {
  const rand = seeded(seed);
  return canvasTexture(512, (ctx, size) => {
    ctx.fillStyle = '#8e887d';
    ctx.fillRect(0, 0, size, size);
    for (let i = 0; i < 3500; i++) {
      const value = 95 + Math.floor(rand() * 70);
      const alpha = .025 + rand() * .08;
      ctx.fillStyle = `rgba(${value},${value - 3},${value - 7},${alpha})`;
      const r = .5 + rand() * 2.4;
      ctx.fillRect(rand() * size, rand() * size, r, r);
    }
    ctx.strokeStyle = 'rgba(56,52,48,.18)';
    ctx.lineWidth = 2;
    for (let i = 0; i < 13; i++) {
      const y = i * size / 13;
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(size, y + (rand() - .5) * 5); ctx.stroke();
    }
  }, repeatX, repeatY);
}

function makeWoodTexture(seed = 3, repeatX = 3, repeatY = 1) {
  const rand = seeded(seed);
  return canvasTexture(512, (ctx, size) => {
    ctx.fillStyle = '#73533b';
    ctx.fillRect(0, 0, size, size);
    for (let i = 0; i < 130; i++) {
      const y = rand() * size;
      ctx.strokeStyle = `rgba(${55 + rand() * 50},${32 + rand() * 25},${18 + rand() * 18},${.08 + rand() * .16})`;
      ctx.lineWidth = .5 + rand() * 2;
      ctx.beginPath();
      ctx.moveTo(0, y);
      for (let x = 0; x <= size; x += 24) ctx.lineTo(x, y + Math.sin(x * .025 + rand() * 3) * (1 + rand() * 5));
      ctx.stroke();
    }
    for (let i = 0; i < 8; i++) {
      const x = rand() * size, y = rand() * size;
      ctx.strokeStyle = 'rgba(38,24,15,.22)';
      ctx.beginPath(); ctx.ellipse(x, y, 18 + rand() * 30, 4 + rand() * 9, 0, 0, Math.PI * 2); ctx.stroke();
    }
  }, repeatX, repeatY);
}

function standardMaterial(color, roughness = .74, metalness = 0, options = {}) {
  return new THREE.MeshStandardMaterial({
    color,
    roughness,
    metalness,
    side: options.side ?? THREE.FrontSide,
    transparent: options.transparent ?? false,
    opacity: options.opacity ?? 1,
    map: options.map ?? null,
    depthWrite: options.depthWrite ?? true,
    emissive: options.emissive ?? 0x000000,
    emissiveIntensity: options.emissiveIntensity ?? 0
  });
}

function addMesh(parent, geometry, material, position = [0, 0, 0], rotation = [0, 0, 0], scale = [1, 1, 1], cast = true, receive = true) {
  const mesh = new THREE.Mesh(geometry, material);
  mesh.position.set(...position);
  mesh.rotation.set(...rotation);
  mesh.scale.set(...scale);
  mesh.castShadow = cast;
  mesh.receiveShadow = receive;
  parent.add(mesh);
  return mesh;
}

function addBox(parent, size, position, material, rotation = [0, 0, 0], cast = true, receive = true) {
  return addMesh(parent, new THREE.BoxGeometry(...size), material, position, rotation, [1, 1, 1], cast, receive);
}

function addCylinder(parent, radiusTop, radiusBottom, height, position, material, radial = 24, rotation = [0, 0, 0], cast = true, receive = true) {
  return addMesh(parent, new THREE.CylinderGeometry(radiusTop, radiusBottom, height, radial, 1, false), material, position, rotation, [1, 1, 1], cast, receive);
}

function addSphere(parent, radius, position, material, segments = 16, scale = [1, 1, 1]) {
  return addMesh(parent, new THREE.SphereGeometry(radius, segments, Math.max(8, Math.floor(segments * .65))), material, position, [0, 0, 0], scale);
}

function cylinderBetween(parent, start, end, radius, material, radial = 10, cast = true) {
  const a = new THREE.Vector3(...start);
  const b = new THREE.Vector3(...end);
  const direction = b.clone().sub(a);
  const length = direction.length();
  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, length, radial), material);
  mesh.position.copy(a).add(b).multiplyScalar(.5);
  mesh.quaternion.setFromUnitVectors(Y_AXIS, direction.normalize());
  mesh.castShadow = cast;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addPlane(parent, width, height, position, material, rotation = [-Math.PI / 2, 0, 0], receive = true) {
  return addMesh(parent, new THREE.PlaneGeometry(width, height), material, position, rotation, [1, 1, 1], false, receive);
}

function disposeObject(object) {
  object.traverse((child) => {
    if (!child.isMesh && !child.isPoints && !child.isLine) return;
    child.geometry?.dispose?.();
    const materials = Array.isArray(child.material) ? child.material : [child.material];
    materials.filter(Boolean).forEach((material) => material.dispose?.());
  });
}

class FloralBatch {
  constructor(config, seedValue = 1) {
    this.config = config;
    this.rand = seeded(seedValue);
    this.petals = config.flower.map(() => []);
    this.centers = [];
    this.leaves = config.leaf.map(() => []);
    this.stems = [];
    this.petalGeometry = new THREE.SphereGeometry(.13, 7, 5);
    this.centerGeometry = new THREE.IcosahedronGeometry(.08, 1);
    this.leafGeometry = new THREE.BufferGeometry();
    this.stemGeometry = new THREE.CylinderGeometry(.012, .018, 1, 7);
    const vertices = new Float32Array([
      0, .52, .015,  -.19, .02, 0,  0, -.52, -.012,
      0, .52, .015,   0, -.52, -.012, .19, .02, 0,
      0, .52, .015,   0, 0, .045, -.19, .02, 0,
      0, .52, .015,   .19, .02, 0, 0, 0, .045
    ]);
    this.leafGeometry.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
    this.leafGeometry.computeVertexNormals();
  }

  pushMatrix(collection, position, quaternion, scale) {
    dummy.position.copy(position);
    dummy.quaternion.copy(quaternion);
    dummy.scale.copy(scale);
    dummy.updateMatrix();
    collection.push(dummy.matrix.clone());
  }

  bloom(position, size = .28, colorIndex = 0, normal = new THREE.Vector3(0, 0, 1), type = 'rose') {
    const n = normal.clone().normalize();
    const baseQ = new THREE.Quaternion().setFromUnitVectors(Z_AXIS, n);
    const petals = type === 'lisianthus' ? 5 : type === 'ranunculus' ? 9 : type === 'delphinium' ? 5 : 7;
    const rings = type === 'ranunculus' ? 2 : type === 'rose' ? 2 : 1;
    for (let ring = 0; ring < rings; ring++) {
      const count = ring === 0 ? petals : Math.max(5, petals - 2);
      const ringRadius = size * (ring === 0 ? .34 : .16);
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * Math.PI * 2 + ring * .36;
        const local = new THREE.Vector3(Math.cos(angle) * ringRadius, Math.sin(angle) * ringRadius, ring * size * .06);
        local.applyQuaternion(baseQ).add(position);
        const q = baseQ.clone().multiply(new THREE.Quaternion().setFromAxisAngle(Z_AXIS, angle - Math.PI / 2));
        q.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), -.12 + this.rand() * .25));
        const petalLength = size * (ring === 0 ? .72 : .48);
        this.pushMatrix(this.petals[colorIndex % this.petals.length], local, q, new THREE.Vector3(petalLength, size * .42, size * .11));
      }
    }
    const centerQ = baseQ;
    this.pushMatrix(this.centers, position.clone().add(n.clone().multiplyScalar(size * .05)), centerQ, new THREE.Vector3(size * .56, size * .56, size * .38));
  }

  leaf(position, size = .32, colorIndex = 0, normal = new THREE.Vector3(0, 0, 1), roll = 0) {
    const q = new THREE.Quaternion().setFromUnitVectors(Z_AXIS, normal.clone().normalize());
    q.multiply(new THREE.Quaternion().setFromAxisAngle(Z_AXIS, roll));
    this.pushMatrix(this.leaves[colorIndex % this.leaves.length], position, q, new THREE.Vector3(size, size, size));
  }

  stem(start, end, radius = .012) {
    const a = start.clone();
    const b = end.clone();
    const direction = b.clone().sub(a);
    const length = direction.length();
    const q = new THREE.Quaternion().setFromUnitVectors(Y_AXIS, direction.normalize());
    this.pushMatrix(this.stems, a.add(b).multiplyScalar(.5), q, new THREE.Vector3(radius / .012, length, radius / .012));
  }

  arrangement(center, options = {}) {
    const count = options.count ?? 22;
    const width = options.width ?? 1.15;
    const depth = options.depth ?? .7;
    const height = options.height ?? .65;
    const normal = options.normal ?? new THREE.Vector3(0, .5, 1);
    for (let i = 0; i < count; i++) {
      const angle = this.rand() * Math.PI * 2;
      const radius = Math.sqrt(this.rand());
      const x = Math.cos(angle) * width * radius;
      const z = Math.sin(angle) * depth * radius;
      const y = Math.max(.05, (1 - radius * .65) * height + (this.rand() - .5) * .16);
      const bloomPos = center.clone().add(new THREE.Vector3(x, y, z));
      const stemBase = center.clone().add(new THREE.Vector3(x * .24, .02, z * .24));
      this.stem(stemBase, bloomPos, .009 + this.rand() * .009);
      this.bloom(bloomPos, .21 + this.rand() * .15, Math.floor(this.rand() * this.petals.length), normal.clone().add(new THREE.Vector3((this.rand() - .5) * .35, this.rand() * .35, 0)), this.rand() > .68 ? 'ranunculus' : this.rand() > .55 ? 'lisianthus' : 'rose');
      if (i % 2 === 0) {
        const leafPos = stemBase.clone().lerp(bloomPos, .45 + this.rand() * .3);
        this.leaf(leafPos, .24 + this.rand() * .15, Math.floor(this.rand() * this.leaves.length), normal, angle + this.rand());
      }
    }
    for (let i = 0; i < Math.ceil(count * .45); i++) {
      const angle = this.rand() * Math.PI * 2;
      const pos = center.clone().add(new THREE.Vector3(Math.cos(angle) * width * (.4 + this.rand() * .7), .2 + this.rand() * height * .65, Math.sin(angle) * depth * (.5 + this.rand() * .6)));
      this.leaf(pos, .3 + this.rand() * .22, i % this.leaves.length, normal, angle);
    }
  }

  archGarland(center, radius = 2.25, rangeA = .55, rangeB = 4.7, options = {}) {
    const count = options.count ?? 74;
    const front = options.front ?? new THREE.Vector3(0, 0, 1);
    for (let i = 0; i < count; i++) {
      const t = i / Math.max(1, count - 1);
      const angle = THREE.MathUtils.lerp(rangeA, rangeB, t);
      const clump = Math.sin(t * Math.PI) * .18 + .12;
      const radial = radius + (this.rand() - .5) * clump;
      const pos = center.clone().add(new THREE.Vector3(Math.cos(angle) * radial, Math.sin(angle) * radial, .06 + (this.rand() - .5) * .24));
      const tangent = new THREE.Vector3(-Math.sin(angle), Math.cos(angle), 0);
      this.bloom(pos, .17 + this.rand() * .15, Math.floor(this.rand() * this.petals.length), front.clone().add(tangent.multiplyScalar(.14)), this.rand() > .64 ? 'ranunculus' : 'rose');
      if (i % 2 === 0) this.leaf(pos.clone().add(new THREE.Vector3((this.rand() - .5) * .18, (this.rand() - .5) * .18, -.08)), .25 + this.rand() * .18, i % this.leaves.length, front, angle + .8);
    }
    for (let i = 0; i < Math.ceil(count * .6); i++) {
      const angle = THREE.MathUtils.lerp(rangeA, rangeB, this.rand());
      const pos = center.clone().add(new THREE.Vector3(Math.cos(angle) * (radius + (this.rand() - .5) * .28), Math.sin(angle) * (radius + (this.rand() - .5) * .28), -.02));
      this.leaf(pos, .32 + this.rand() * .24, i % this.leaves.length, front, angle + this.rand() * .9);
    }
  }

  flush(parent) {
    const addInstances = (geometry, matrices, material) => {
      if (!matrices.length) return;
      const mesh = new THREE.InstancedMesh(geometry, material, matrices.length);
      matrices.forEach((matrix, index) => mesh.setMatrixAt(index, matrix));
      mesh.instanceMatrix.needsUpdate = true;
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mesh.frustumCulled = false;
      parent.add(mesh);
    };
    this.petals.forEach((matrices, index) => addInstances(this.petalGeometry, matrices, standardMaterial(this.config.flower[index], .83, 0, { side: THREE.DoubleSide })));
    addInstances(this.centerGeometry, this.centers, standardMaterial(0xc29a55, .82));
    this.leaves.forEach((matrices, index) => addInstances(this.leafGeometry, matrices, standardMaterial(this.config.leaf[index], .86, 0, { side: THREE.DoubleSide })));
    addInstances(this.stemGeometry, this.stems, standardMaterial(this.config.leaf[0], .9));
  }
}

function makeGround(parent, config, options = {}) {
  const wet = options.wet ?? false;
  const texture = makeStoneTexture(29 + state.index, 6, 5);
  const material = standardMaterial(options.color ?? config.ground, wet ? .22 : .88, 0, { map: texture });
  const ground = addPlane(parent, options.width ?? 30, options.depth ?? 25, [0, options.y ?? 0, -1], material);
  if (wet) {
    const puddleMaterial = standardMaterial(0x5f6b6e, .08, .03, { transparent: true, opacity: .34, depthWrite: false });
    [[-3.2, .018, 2.4, 2.8, 1.1], [3.6, .019, -.4, 1.8, .8], [1.1, .021, 4.0, 1.4, .7]].forEach(([x,y,z,sx,sy]) => {
      addMesh(parent, new THREE.CircleGeometry(1, 36), puddleMaterial, [x,y,z], [-Math.PI/2,0,0], [sx,sy,1], false, false);
    });
  }
  return ground;
