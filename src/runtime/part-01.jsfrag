const Y_AXIS = new THREE.Vector3(0, 1, 0);
const Z_AXIS = new THREE.Vector3(0, 0, 1);
const dummy = new THREE.Object3D();

function seeded(seed) {
  let value = seed >>> 0;
  return () => {
    value += 0x6D2B79F5;
    let t = value;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function srgb(color) {
  return new THREE.Color(color);
}

function canvasTexture(size, painter, repeatX = 1, repeatY = 1) {
  const textureCanvas = document.createElement('canvas');
  textureCanvas.width = size;
  textureCanvas.height = size;
  const ctx = textureCanvas.getContext('2d');
  painter(ctx, size);
  const texture = new THREE.CanvasTexture(textureCanvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.wrapS = texture.wrapT = THREE.RepeatWrapping;
  texture.repeat.set(repeatX, repeatY);
  texture.anisotropy = Math.min(8, renderer?.capabilities.getMaxAnisotropy?.() || 4);
  currentTextures.push(texture);
  return texture;
}

function makeBrickTexture(seed = 1, repeatX = 5, repeatY = 3) {
  const rand = seeded(seed);
  return canvasTexture(512, (ctx, size) => {
    ctx.fillStyle = '#7b4a38';
    ctx.fillRect(0, 0, size, size);
    const rows = 16;
    const h = size / rows;
    const w = h * 2.05;
    ctx.lineWidth = 2.2;
    for (let row = 0; row < rows; row++) {
      const offset = row % 2 ? -w / 2 : 0;
      for (let x = offset; x < size; x += w) {
        const warm = Math.floor(54 + rand() * 38);
        ctx.fillStyle = `rgb(${112 + warm / 3},${53 + warm / 6},${39 + warm / 9})`;
        ctx.fillRect(x + 2, row * h + 2, w - 4, h - 4);
        ctx.fillStyle = `rgba(55,31,24,${0.06 + rand() * 0.08})`;
        ctx.fillRect(x + 5, row * h + 5, w - 10, Math.max(2, h * .12));
      }
    }
    ctx.strokeStyle = '#9f8a77';
    ctx.globalAlpha = .8;
    for (let row = 0; row <= rows; row++) {
      ctx.beginPath(); ctx.moveTo(0, row * h); ctx.lineTo(size, row * h); ctx.stroke();
    }
    for (let row = 0; row < rows; row++) {
      const offset = row % 2 ? -w / 2 : 0;
      for (let x = offset; x < size; x += w) {
        ctx.beginPath(); ctx.moveTo(x, row * h); ctx.lineTo(x, (row + 1) * h); ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;
    for (let i = 0; i < 1200; i++) {