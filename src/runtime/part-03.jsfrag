}

function buildLeadedWindow(parent, x, y, z, width = 2.25, height = 3.5) {
  const stone = standardMaterial(0x9a9184, .91);
  const lead = standardMaterial(0x33383a, .48, .22);
  const glass = standardMaterial(0x8ea2a3, .18, 0, { transparent: true, opacity: .42, side: THREE.DoubleSide, depthWrite: false });
  addBox(parent, [width + .34, height + .34, .22], [x, y, z], stone);
  addBox(parent, [width, height, .13], [x, y, z + .13], glass, [0,0,0], false, false);
  const cols = 4, rows = 6;
  for (let i = 0; i <= cols; i++) addBox(parent, [.026, height, .055], [x - width/2 + i*width/cols, y, z + .205], lead, [0,0,0], false, false);
  for (let j = 0; j <= rows; j++) addBox(parent, [width, .026, .055], [x, y - height/2 + j*height/rows, z + .205], lead, [0,0,0], false, false);
  for (let i = 0; i < cols; i++) {
    for (let j = 0; j < rows; j++) {
      cylinderBetween(parent,
        [x-width/2+i*width/cols, y-height/2+j*height/rows, z+.24],
        [x-width/2+(i+1)*width/cols, y-height/2+(j+1)*height/rows, z+.24],
        .008, lead, 5, false);
    }
  }
}

function buildAldieFacade(parent, options = {}) {
  const brickTexture = makeBrickTexture(77 + state.index, 7, 3.8);
  const brick = standardMaterial(options.brick ?? 0x7c4936, .88, 0, { map: brickTexture });
  const stone = standardMaterial(0x93897c, .92, 0, { map: makeStoneTexture(31, 4, 2) });
  const darkWood = standardMaterial(0x3b2b22, .82, 0, { map: makeWoodTexture(18, 2, 2) });
  const z = options.z ?? -6.1;
  addBox(parent, [18, 7.7, .58], [0, 3.85, z], brick);
  addBox(parent, [18.4, .45, .8], [0, .23, z + .05], stone);
  addBox(parent, [18.1, .32, .72], [0, 7.66, z + .02], stone);
  buildLeadedWindow(parent, -5.4, 4.25, z + .38, 2.45, 3.8);
  buildLeadedWindow(parent, 5.4, 4.25, z + .38, 2.45, 3.8);
  // Central Tudor-style doorway, with visible depth and threshold.
  addBox(parent, [3.2, 4.4, .28], [0, 2.22, z + .4], stone);
  addBox(parent, [2.65, 3.85, .18], [0, 1.95, z + .62], darkWood);
  addBox(parent, [.08, 3.75, .08], [0, 1.92, z + .75], standardMaterial(0x23211f, .55, .16));
  addBox(parent, [2.68, .16, .55], [0, .08, z + .62], stone);
  const handleMaterial = standardMaterial(0x887352, .35, .5);
  addSphere(parent, .055, [-.2, 1.75, z + .86], handleMaterial, 12);
  addSphere(parent, .055, [.2, 1.75, z + .86], handleMaterial, 12);
  // Structural buttresses and rainwater downpipes.
  [-8.25, -3.2, 3.2, 8.25].forEach((x) => addBox(parent, [.48, 7.25, .8], [x, 3.6, z + .14], brick));
  const pipe = standardMaterial(0x3d4241, .52, .42);
  [-8.55, 8.55].forEach((x) => {
    addCylinder(parent, .055, .055, 6.9, [x, 3.4, z + .55], pipe, 10);
    addBox(parent, [.2, .12, .45], [x + (x < 0 ? .09 : -.09), .1, z + .7], pipe);
  });
  if (options.terrace !== false) {
    for (let i = 0; i < 3; i++) addBox(parent, [6.2 + i*.5, .18, .72], [0, .09 + i*.18, z + 1.25 + i*.62], stone);
  }
}

function buildCircularArch(parent, batch, options = {}) {
  const center = options.center ?? new THREE.Vector3(0, 2.38, -1.7);
  const radius = options.radius ?? 2.25;
  const metal = standardMaterial(options.metal ?? 0x383b39, .38, .58);
  const ring = new THREE.Mesh(new THREE.TorusGeometry(radius, .033, 8, 96), metal);
  ring.position.copy(center);
  ring.castShadow = true;
  parent.add(ring);
  const footY = .055;
  [-.72, .72].forEach((x) => {
    addBox(parent, [.92, .085, .72], [center.x + x, footY, center.z], metal);
    cylinderBetween(parent, [center.x + x, .08, center.z], [center.x + x, center.y - radius + .42, center.z], .025, metal, 8);
    // Sandbags are visible, asymmetric, and sit behind the frame.
    const bag = standardMaterial(0x69685f, .94);
    addBox(parent, [.68, .16, .35], [center.x + x + (x < 0 ? -.1 : .13), .17, center.z - .3], bag, [0, x < 0 ? -.09 : .07, 0]);
  });
  if (options.drape !== false) {
    const cloth = standardMaterial(0xeee8df, .96, 0, { transparent: true, opacity: .82, side: THREE.DoubleSide });
    const left = addPlane(parent, 1.0, 4.1, [center.x - .72, center.y - .1, center.z - .06], cloth, [0, .03, 0], false);
    left.geometry.translate(0, 0, 0);
    addPlane(parent, .86, 3.85, [center.x + .76, center.y - .2, center.z - .07], cloth, [0, -.04, 0], false);
  }
  if (batch && options.flowers !== false) {
    batch.archGarland(center, radius, options.rangeA ?? .3, options.rangeB ?? 4.9, { count: options.count ?? 78 });
  }
  return { center, radius, ring };
}

function buildStoneFountain(parent, batch, options = {}) {
  const center = options.center ?? new THREE.Vector3(0, 0, -1.2);
  const stone = standardMaterial(0x8e887e, .84, 0, { map: makeStoneTexture(92 + state.index, 3, 3) });
  const worn = standardMaterial(0x756f67, .94);
  const water = standardMaterial(0x6d9b9e, .08, .02, { transparent: true, opacity: .62, side: THREE.DoubleSide, depthWrite: false });
  addCylinder(parent, 2.25, 2.34, .38, [center.x, .19, center.z], stone, 48);
  addCylinder(parent, 1.86, 1.9, .23, [center.x, .42, center.z], worn, 48);
  addCylinder(parent, 1.72, 1.72, .035, [center.x, .55, center.z], water, 48, [0,0,0], false, false);
  addCylinder(parent, .43, .62, 1.36, [center.x, 1.1, center.z], stone, 30);
  addCylinder(parent, 1.0, .76, .18, [center.x, 1.78, center.z], stone, 42);
  addCylinder(parent, .82, .82, .025, [center.x, 1.91, center.z], water, 42, [0,0,0], false, false);
  addCylinder(parent, .16, .28, .7, [center.x, 2.25, center.z], stone, 24);
  addSphere(parent, .2, [center.x, 2.68, center.z], stone, 16, [1,1.25,1]);
  if (options.water !== false) {
    const jetMat = standardMaterial(0xaecfd0, .05, 0, { transparent: true, opacity: .34, depthWrite: false });
    for (let i = 0; i < 8; i++) {
      const angle = i / 8 * Math.PI * 2;
      const curve = new THREE.QuadraticBezierCurve3(
        new THREE.Vector3(center.x + Math.cos(angle)*.18, 2.57, center.z + Math.sin(angle)*.18),
        new THREE.Vector3(center.x + Math.cos(angle)*.68, 2.92, center.z + Math.sin(angle)*.68),
        new THREE.Vector3(center.x + Math.cos(angle)*1.18, 1.95, center.z + Math.sin(angle)*1.18)
      );
      const jet = addMesh(parent, new THREE.TubeGeometry(curve, 16, .018, 5, false), jetMat, [0,0,0], [0,0,0], [1,1,1], false, false);
      state.waterDrops.push(jet);
    }
  }
  if (batch) {
    const floralCenter = new THREE.Vector3(center.x - .45, .36, center.z + 1.86);
    batch.arrangement(floralCenter, { count: options.flowerCount ?? 40, width: 1.55, depth: .4, height: .72, normal: new THREE.Vector3(0, .3, 1) });
    // A trailing branch breaks symmetry and follows the basin curve.
    for (let i = 0; i < 11; i++) {
      const a = 1.22 + i * .075;
      const pos = new THREE.Vector3(center.x + Math.cos(a)*2.08, .34 + Math.sin(i*.45)*.04, center.z + Math.sin(a)*2.08);
      batch.leaf(pos, .28 + (i%3)*.04, i%2, new THREE.Vector3(0,.25,1), a);
      if (i % 3 === 1) batch.bloom(pos.clone().add(new THREE.Vector3(0,.12,.02)), .22, i%4, new THREE.Vector3(0,.2,1), 'lisianthus');
    }
  }
  return center;
}

function buildChair(parent, position, rotationY = 0, options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  group.rotation.y = rotationY;
  parent.add(group);
  const wood = standardMaterial(options.color ?? 0x6d543f, .78);
  addBox(group, [.52, .055, .46], [0, .48, 0], wood);
  addBox(group, [.52, .055, .08], [0, .86, -.19], wood);
  [-.22,.22].forEach(x => {
    addBox(group, [.045, .9, .045], [x, .45, -.18], wood);
    addBox(group, [.04, .48, .04], [x, .24, .18], wood);
  });
  for (let i=-1;i<=1;i++) addBox(group, [.035,.37,.035], [i*.16,.68,-.19], wood);
  return group;
}

function buildTable(parent, position, size = [3.6, .1, 1.0], options = {}) {
  const group = new THREE.Group();
  group.position.set(...position);
  parent.add(group);
  const wood = standardMaterial(options.wood ?? 0x65472f, .72, 0, { map: makeWoodTexture(44, 3, 1) });
  const linen = standardMaterial(options.linen ?? 0xd8d0c4, .98, 0, { side: THREE.DoubleSide });
  addBox(group, size, [0, .77, 0], wood);
  if (options.cloth !== false) {
    addBox(group, [size[0] + .08, .035, size[2] + .08], [0, .84, 0], linen, [0,0,0], false, true);
    if (options.drape) {
      addPlane(group, size[0], .72, [0,.47,size[2]/2+.045], linen, [0,0,0], false);
    }
  }
  const x = size[0]/2 - .25, z = size[2]/2 - .18;
  [[-x,-z],[-x,z],[x,-z],[x,z]].forEach(([px,pz]) => addBox(group,[.09,.76,.09],[px,.38,pz],wood));
  return group;
}

function buildCandle(parent, position, height = .32, lit = true) {
  const wax = standardMaterial(0xe7ddd0, .9);
  const holder = standardMaterial(0x9b7d52, .25, .62);
  addCylinder(parent, .055, .055, height, [position[0], position[1] + height/2, position[2]], wax, 16);
  addCylinder(parent, .12, .14, .035, [position[0], position[1] + .018, position[2]], holder, 18);
  if (lit) {
    const flameMat = standardMaterial(0xffc36a, .5, 0, { emissive: 0xff8c37, emissiveIntensity: 2.2 });
    const flame = addSphere(parent, .035, [position[0], position[1] + height + .045, position[2]], flameMat, 10, [.7,1.5,.7]);
    const light = new THREE.PointLight(0xffa35c, .55, 2.4, 2);
    light.position.set(position[0], position[1] + height + .18, position[2]);
    parent.add(light);
    state.candleLights.push({ light, flame, phase: Math.random()*Math.PI*2 });
  }
}

function buildTree(parent, position, scale = 1, color = 0x43583e) {
  const trunk = standardMaterial(0x554033, .95);
  const leaves = standardMaterial(color, .93);
  addCylinder(parent, .18*scale, .27*scale, 3.0*scale, [position[0], 1.5*scale, position[2]], trunk, 9);
  const group = new THREE.Group();
  group.position.set(position[0], 3.1*scale, position[2]);
  parent.add(group);
  [[0,0,0,1.25],[-.85,.1,.1,.85],[.8,.2,-.05,.92],[-.25,.7,-.2,.8],[.2,-.5,.15,.82]].forEach(([x,y,z,r]) => {
    const mesh = addSphere(group, r*scale, [x*scale,y*scale,z*scale], leaves, 9, [1.0,.78,1.05]);
    mesh.rotation.y = Math.random();
  });
  state.sway.push({ object: group, amount: .006 + Math.random()*.006, phase: Math.random()*6 });
}

function createLabelTexture(text) {
  return canvasTexture(512, (ctx, size) => {
    ctx.clearRect(0,0,size,size);
    ctx.fillStyle = 'rgba(242,239,232,.94)';
    ctx.fillRect(18, 158, size-36, 196);
    ctx.strokeStyle = 'rgba(47,58,58,.4)';
    ctx.lineWidth = 5;
    ctx.strokeRect(18, 158, size-36, 196);
    ctx.fillStyle = '#283434';
    ctx.font = '700 54px system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, size/2, size/2 + 2);
  }, 1, 1);
}

function addLabel(parent, text, position, scale = [1.5,.55,1]) {
  const material = standardMaterial(0xffffff, .9, 0, { map: createLabelTexture(text), transparent: true, opacity: 1, side: THREE.DoubleSide });
  return addPlane(parent, 1, 1, position, material, [0,0,0], false).scale.set(...scale);
}

function addDimension(parent, start, end, text) {
  const lineMat = standardMaterial(0x354b50, .55, .25);
  cylinderBetween(parent, start, end, .012, lineMat, 6, false);
  const a = new THREE.Vector3(...start), b = new THREE.Vector3(...end);
  const direction = b.clone().sub(a).normalize();
  const coneGeo = new THREE.ConeGeometry(.06, .18, 8);
  const coneA = new THREE.Mesh(coneGeo, lineMat);
  coneA.position.copy(a); coneA.quaternion.setFromUnitVectors(Y_AXIS, direction); parent.add(coneA);
  const coneB = new THREE.Mesh(coneGeo, lineMat);
  coneB.position.copy(b); coneB.quaternion.setFromUnitVectors(Y_AXIS, direction.clone().negate()); parent.add(coneB);
  const mid = a.clone().add(b).multiplyScalar(.5);
  addLabel(parent, text, [mid.x, mid.y + .2, mid.z + .03], [1.25,.46,1]);
}

function buildBucket(parent, position, color = 0x6b7372, flowers = false, batch = null) {
  const metal = standardMaterial(color, .34, .55);
  addCylinder(parent, .31, .25, .62, [position[0], position[1]+.31, position[2]], metal, 22);
  const water = standardMaterial(0x70979a, .08, 0, { transparent: true, opacity: .55, depthWrite: false });
  addCylinder(parent, .27, .27, .018, [position[0], position[1]+.58, position[2]], water, 22, [0,0,0], false, false);
  const handle = new THREE.Mesh(new THREE.TorusGeometry(.36,.018,6,28,Math.PI), metal);
  handle.position.set(position[0], position[1]+.45, position[2]);
  handle.rotation.z = Math.PI/2;
  parent.add(handle);
  if (flowers && batch) {
    for (let i=0;i<8;i++) {
      const angle=i/8*Math.PI*2;
      const base = new THREE.Vector3(position[0]+Math.cos(angle)*.08,position[1]+.55,position[2]+Math.sin(angle)*.08);
      const top = new THREE.Vector3(position[0]+Math.cos(angle)*(.16+Math.random()*.15),position[1]+1.25+Math.random()*.4,position[2]+Math.sin(angle)*(.16+Math.random()*.15));
      batch.stem(base,top,.012);
      batch.bloom(top,.22+Math.random()*.08,i%batch.petals.length,new THREE.Vector3(0,.25,1),i%3===0?'lisianthus':'rose');
      if(i%2===0) batch.leaf(base.clone().lerp(top,.62),.28,i%2,new THREE.Vector3(0,.2,1),angle);
    }
  }
}

function buildCrate(parent, position, size=[1.0,.58,.7], label='FLOWERS') {
