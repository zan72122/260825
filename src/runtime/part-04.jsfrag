  const wood=standardMaterial(0x806044,.88,0,{map:makeWoodTexture(62,2,2)});
  addBox(parent,size,[position[0],position[1]+size[1]/2,position[2]],wood);
  const slat=standardMaterial(0x5f432e,.9);
  [-1,0,1].forEach(i=>addBox(parent,[.055,size[1]+.04,size[2]+.04],[position[0]+i*size[0]*.43,position[1]+size[1]/2,position[2]],slat));
  const labelTexture=createLabelTexture(label);
  const labelMat=standardMaterial(0xffffff,.9,0,{map:labelTexture,transparent:true,side:THREE.DoubleSide});
  addPlane(parent,.58,.26,[position[0],position[1]+size[1]*.55,position[2]+size[2]/2+.006],labelMat,[0,0,0],false);
}

function buildVan(parent, position=[-4.8,0,1.3]) {
  const body=standardMaterial(0xd6d7d2,.48,.08);
  const trim=standardMaterial(0x252a2a,.4,.45);
  const glass=standardMaterial(0x4b6268,.12,.08,{transparent:true,opacity:.62,depthWrite:false});
  const group=new THREE.Group(); group.position.set(...position); parent.add(group);
  addBox(group,[5.2,2.25,2.35],[0,1.62,0],body);
  addBox(group,[1.65,1.9,2.18],[3.15,1.38,0],body,[0,0,-.08]);
  addBox(group,[1.05,.85,2.02],[3.62,2.0,0],glass,[0,0,-.08],false,false);
  // Open rear door with realistic thickness.
  addBox(group,[.09,2.08,1.02],[-2.66,1.6,-1.13],body,[0,-.55,0]);
  addBox(group,[.09,2.08,1.02],[-2.66,1.6,1.13],body,[0,.55,0]);
  [[-1.75,-1.1],[-1.75,1.1],[2.55,-1.1],[2.55,1.1]].forEach(([x,z])=>{
    const wheel=addCylinder(group,.38,.38,.22,[x,.43,z],trim,20,[Math.PI/2,0,0]);
    addCylinder(group,.17,.17,.235,[x,.43,z],standardMaterial(0x7e8582,.32,.55),16,[Math.PI/2,0,0]);
  });
  addBox(group,[5.25,.18,.18],[0,.65,-1.17],trim);
  addBox(group,[5.25,.18,.18],[0,.65,1.17],trim);
  return group;
}

function buildWorkshopTools(parent, tablePos=[0,0,0]) {
  const steel=standardMaterial(0x5d6464,.34,.65);
  const rubber=standardMaterial(0x303736,.76);
  // Floral snips: two blades, pivot and handles.
  const x=tablePos[0]+.55,y=tablePos[1]+.9,z=tablePos[2]+.12;
  addBox(parent,[.55,.025,.065],[x,y,z],steel,[0,.25,.05]);
  addBox(parent,[.52,.025,.065],[x,y,z+.09],steel,[0,-.25,-.05]);
  addCylinder(parent,.05,.05,.06,[x-.12,y+.03,z+.045],steel,12,[Math.PI/2,0,0]);
  addMesh(parent,new THREE.TorusGeometry(.13,.035,8,22),rubber,[x-.34,y+.015,z-.02],[Math.PI/2,0,0],[1,1,1]);
  addMesh(parent,new THREE.TorusGeometry(.13,.035,8,22),rubber,[x-.34,y+.015,z+.12],[Math.PI/2,0,0],[1,1,1]);
  // Florist tape and cable ties.
  addMesh(parent,new THREE.TorusGeometry(.12,.04,8,24),standardMaterial(0x466151,.82),[x+.4,y+.02,z-.18],[Math.PI/2,0,0],[1,1,1]);
  for(let i=0;i<6;i++) addBox(parent,[.015,.015,.45],[x-.25+i*.035,y+.04,z-.28],standardMaterial(0x202626,.55,.2),[0,.1*i,.06]);
}

function buildLadder(parent, position=[3.7,0,-1.8], rotationY=-.15) {
  const group=new THREE.Group(); group.position.set(...position); group.rotation.y=rotationY; parent.add(group);
  const aluminum=standardMaterial(0xb0b5b2,.28,.72);
  cylinderBetween(group,[-.42,0,0],[ -.22,3.25,0],.035,aluminum,8);
  cylinderBetween(group,[.42,0,0],[ .22,3.25,0],.035,aluminum,8);
  for(let i=0;i<8;i++){
    const y=.28+i*.38;
    addBox(group,[.68,.045,.13],[0,y,0],aluminum);
  }
  return group;
}

function addDust(parent, color=0xffffff, count=230, area=[16,8,12]) {
  const positions=new Float32Array(count*3);
  const rand=seeded(300+state.index);
  for(let i=0;i<count;i++){
    positions[i*3]=(rand()-.5)*area[0];
    positions[i*3+1]=.4+rand()*area[1];
    positions[i*3+2]=-4+(rand()-.5)*area[2];
  }
  const geometry=new THREE.BufferGeometry(); geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const material=new THREE.PointsMaterial({color,size:.018,transparent:true,opacity:.26,depthWrite:false});
  const points=new THREE.Points(geometry,material); parent.add(points); state.dust=points;
}

function buildCourtyard(parent, config, options={}) {
  makeGround(parent,config,{width:30,depth:25,color:config.ground,wet:options.wet});
  buildAldieFacade(parent,{z:-6.6,brick:options.brick});
  const batch=new FloralBatch(config,101+state.index);
  buildCircularArch(parent,batch,{center:new THREE.Vector3(2.3,2.48,-1.65),radius:2.3,count:86});
  buildStoneFountain(parent,batch,{center:new THREE.Vector3(-3.55,0,-1.5),flowerCount:34,water:options.water!==false});
  // Foreground worktable and grounded transport pieces create clear near/mid/far layers.
  const table=buildTable(parent,[4.7,0,3.0],[2.5,.11,.82],{cloth:false});
  buildBucket(parent,[3.9,0,3.1],0x626968,true,batch);
  buildCrate(parent,[5.4,0,3.15],[.86,.48,.62],'TOOLS');
  buildWorkshopTools(parent,[4.7,0,3.0]);
  // Guests' chairs have a genuine aisle rather than decorative symmetry around camera.
  [[-1.6,2.5],[-.4,2.55],[.8,2.65]].forEach(([x,z])=>buildChair(parent,[x,0,z],Math.PI));
  batch.flush(parent);
  addDust(parent,0xfff5df,170,[18,7,12]);
}

function buildFountainLayout(parent,config){
  makeGround(parent,config,{width:25,depth:20});
  buildAldieFacade(parent,{z:-7.2});
  const batch=new FloralBatch(config,222);
  buildStoneFountain(parent,batch,{center:new THREE.Vector3(0,0,-.5),flowerCount:62});
  // Low work crate at the edge reveals that this is an installation, not a fantasy still life.
  buildCrate(parent,[4.0,0,1.8],[1.0,.52,.72],'STEMS');
  buildBucket(parent,[3.2,0,2.0],0x5f6866,true,batch);
  const hose=standardMaterial(0x3f5145,.72);
  const curve=new THREE.CatmullRomCurve3([
    new THREE.Vector3(-4.7,.05,3.5),new THREE.Vector3(-3.0,.05,2.4),new THREE.Vector3(-2.6,.05,.8),new THREE.Vector3(-1.9,.05,-.2)
  ]);
  addMesh(parent,new THREE.TubeGeometry(curve,36,.035,8,false),hose,[0,0,0],[0,0,0],[1,1,1],true,true);
  batch.flush(parent);
  addDust(parent,0xffffff,160,[14,6,10]);
}

function buildWorkshop(parent,config){
  const concrete=standardMaterial(0x666966,.9,0,{map:makeStoneTexture(4,6,5)});
  addPlane(parent,30,22,[0,0,-1],concrete);
  const wall=standardMaterial(0x4f5656,.93);
  addBox(parent,[18,7,.35],[0,3.5,-6.2],wall);
  addBox(parent,[.35,7,16],[-9,3.5,1],wall);
  const beam=standardMaterial(0x323838,.48,.6);
  for(let x=-8;x<=8;x+=4) addBox(parent,[.16,7.2,.16],[x,3.6,-5.9],beam);
  // Open service door creates a far daylight layer.
  addBox(parent,[5.2,5.1,.18],[4.8,2.55,-6.0],standardMaterial(0xa7b2ae,.3,0,{emissive:0x70827d,emissiveIntensity:.18}));
  addBox(parent,[5.55,.22,.42],[4.8,5.15,-5.85],beam);
  const batch=new FloralBatch(config,303);
  const table1=buildTable(parent,[-1.4,0,-.1],[4.2,.11,1.2],{cloth:false,wood:0x6b6257});
  const table2=buildTable(parent,[4.4,0,1.7],[3.1,.11,1.0],{cloth:false,wood:0x5c5750});
  [-5.2,-4.4,-3.6].forEach((x,i)=>buildBucket(parent,[x,0,.7+i*.2],0x667071,true,batch));
  buildBucket(parent,[3.55,0,1.75],0x626c6d,true,batch);
  buildBucket(parent,[4.3,0,1.75],0x626c6d,true,batch);
  buildWorkshopTools(parent,[-1.4,0,-.1]);
  buildLadder(parent,[6.5,0,-2.4],-.18);
  // Half-built arch, with mechanics intentionally visible.
  buildCircularArch(parent,batch,{center:new THREE.Vector3(-4.5,2.32,-3.45),radius:2.1,rangeA:.4,rangeB:2.9,count:35,drape:false});
  buildCrate(parent,[.2,0,2.7],[1.2,.6,.8],'VASES');
  buildCrate(parent,[1.65,0,2.9],[.9,.46,.65],'TAPE');
  // Spare vessels and water stains are functional, not ornamental.
  for(let i=0;i<5;i++) addCylinder(parent,.16+.02*i,.12+.015*i,.32+.05*i,[-.5+i*.34,.16+.025*i,-.15],standardMaterial(0x9b8e7d,.23,.15),18);
  const stain=standardMaterial(0x454d4c,.95,0,{transparent:true,opacity:.34,depthWrite:false});
  addMesh(parent,new THREE.CircleGeometry(1,32),stain,[-3.8,.012,1.1],[-Math.PI/2,0,0],[1.3,.55,1],false,false);
  batch.flush(parent);
  addDust(parent,0xffe8c6,260,[18,7,14]);
}

function buildLoadIn(parent,config){
  makeGround(parent,config,{width:34,depth:25,wet:true,color:0x465052});
  buildAldieFacade(parent,{z:-7.0,brick:0x694b42,terrace:false});
  buildVan(parent,[-5.2,0,.6]);
  const batch=new FloralBatch(config,404);
  // Rolling dolly and strapped circular frame.
  const dolly=standardMaterial(0x444b4b,.32,.55);
  addBox(parent,[2.1,.12,1.05],[2.4,.25,2.3],dolly);
  [[1.6,1.9],[3.2,1.9],[1.6,2.7],[3.2,2.7]].forEach(([x,z])=>addCylinder(parent,.12,.12,.08,[x,.12,z],standardMaterial(0x1c2121,.65),14,[Math.PI/2,0,0]));
  const hoop=new THREE.Mesh(new THREE.TorusGeometry(1.25,.035,8,64),standardMaterial(0x383d3d,.35,.62));
  hoop.position.set(2.4,1.35,2.3); hoop.rotation.y=.08; hoop.castShadow=true; parent.add(hoop);
  buildCrate(parent,[.6,0,1.9],[1.2,.62,.82],'ARCH');
  buildCrate(parent,[4.25,0,2.1],[1.0,.55,.72],'LINEN');
  [0,1,2].forEach(i=>buildBucket(parent,[.2+i*.68,0,3.55],0x5d6869,true,batch));
  // Rubber ramp, anti-slip ridges, and a rain tarp over flower crates.
  addBox(parent,[3.0,.1,1.7],[-2.4,.05,1.0],standardMaterial(0x323839,.84));
  const tarp=standardMaterial(0x657c7d,.72,0,{transparent:true,opacity:.78,side:THREE.DoubleSide});
  addPlane(parent,3.1,2.1,[.9,1.45,3.6],tarp,[Math.PI/2.6,0,.05],false);
  batch.flush(parent);
}

function buildGarden(parent,config){
  const grass=standardMaterial(0x526544,.96);
  addPlane(parent,34,34,[0,0,-4],grass);
  const path=standardMaterial(0xa99a80,.93,0,{map:makeStoneTexture(70,2,7)});
  addPlane(parent,3.3,25,[0,.012,-4],path);
  buildTree(parent,[-8,0,-2],1.4,0x40563c);
  buildTree(parent,[8,0,-3],1.25,0x455b3e);
  buildTree(parent,[-7,0,-10],1.15,0x4e6445);
  buildTree(parent,[7,0,-11],1.5,0x3d5139);
  const batch=new FloralBatch(config,505);
  buildCircularArch(parent,batch,{center:new THREE.Vector3(0,2.35,-10.2),radius:2.2,count:78,drape:false});
  // Six chair rows, real aisle clearances, slightly imperfect alignment.
  for(let row=0;row<6;row++){
    const z=4.2-row*2.05;
    for(let col=0;col<4;col++){
      const x=-5.0+col*1.12;
      buildChair(parent,[x+(row%2)*.05,0,z],Math.PI,{color:0x765b43});
      buildChair(parent,[-x-(row%2)*.04,0,z+.03],Math.PI,{color:0x765b43});
    }
    if(row<5){
      batch.arrangement(new THREE.Vector3(-1.95,.02,z-.55),{count:12,width:.6,depth:.34,height:.46});
      batch.arrangement(new THREE.Vector3(1.95,.02,z-.45),{count:11,width:.62,depth:.32,height:.43});
    }
  }
  batch.flush(parent);
  addDust(parent,0xffefc7,210,[20,8,20]);
}

function buildGlasshouse(parent,config){
  const floor=standardMaterial(0x8e8b83,.88,0,{map:makeStoneTexture(6,6,6)});
  addPlane(parent,28,26,[0,0,-2],floor);
  const steel=standardMaterial(0x4a5351,.32,.62);
  const glass=standardMaterial(0xb8d2cf,.08,0,{transparent:true,opacity:.18,side:THREE.DoubleSide,depthWrite:false});
  const width=16,depth=18,height=7;
  [-width/2,width/2].forEach(x=>{
    for(let z=-10;z<=8;z+=3) addBox(parent,[.11,height,.11],[x,height/2,z],steel);
  });
  for(let z=-10;z<=8;z+=3){
    addBox(parent,[width,.11,.11],[0,height,z],steel);
    cylinderBetween(parent,[-width/2,height,z],[0,height+3,z],.055,steel,8);
    cylinderBetween(parent,[width/2,height,z],[0,height+3,z],.055,steel,8);
  }
  addPlane(parent,width,depth,[0,height/2,-1],glass,[0,Math.PI/2,0],false);
  addPlane(parent,width,depth,[0,height/2,-1],glass,[0,-Math.PI/2,0],false);
  // Far glass wall with frame.
  addPlane(parent,width,height,[0,height/2,-10],glass,[0,0,0],false);
  for(let x=-8;x<=8;x+=2) addBox(parent,[.06,height,.08],[x,height/2,-9.92],steel);
  const batch=new FloralBatch(config,606);
  const table=buildTable(parent,[0,0,-1.8],[8.6,.12,1.35],{linen:0xded9d0});
  for(let x=-3.6;x<=3.6;x+=1.2) batch.arrangement(new THREE.Vector3(x,.84,-1.8),{count:9,width:.52,depth:.38,height:.42});
  for(let i=0;i<8;i++) buildCandle(parent,[-3.8+i*1.08,.86,-1.42],.25,true);
  // Suspended frame: four safety cables, rigid mesh, then a cloud that does not float magically.
  const frame=standardMaterial(0x3f4847,.34,.62);
  addBox(parent,[6.8,.07,.09],[0,4.65,-2.0],frame);
  addBox(parent,[.09,.07,2.2],[-3.35,4.65,-2.0],frame);
  addBox(parent,[.09,.07,2.2],[3.35,4.65,-2.0],frame);
  addBox(parent,[6.8,.07,.09],[0,4.65,-3.05],frame);
  [[-3.3,-3.0],[3.3,-3.0],[-3.3,-1.0],[3.3,-1.0]].forEach(([x,z])=>cylinderBetween(parent,[x,4.68,z],[x,8.4,z],.012,frame,6,false));
  for(let i=0;i<54;i++){
    const x=(Math.random()-.5)*6.2,y=4.45+(Math.random()-.5)*.75,z=-2.05+(Math.random()-.5)*1.75;
    batch.bloom(new THREE.Vector3(x,y,z),.18+Math.random()*.15,i%4,new THREE.Vector3(0,-.15,1),i%4===0?'lisianthus':'rose');
    if(i%2===0) batch.leaf(new THREE.Vector3(x,y-.08,z-.04),.3,i%2,new THREE.Vector3(0,-.1,1),Math.random()*6);
  }
  batch.flush(parent);
  addDust(parent,0xffffff,260,[17,9,18]);
}

function buildReception(parent,config,winter=false){
  const floor=standardMaterial(winter?0xa7a39b:0x574b40,.72,0,{map:makeWoodTexture(25,5,9)});
  addPlane(parent,28,28,[0,0,-3],floor);
  const wall=standardMaterial(winter?0xc8c8c2:0x6f6255,.93);
  addBox(parent,[19,8,.45],[0,4,-11.0],wall);
  const trim=standardMaterial(winter?0x8f9694:0x3e3027,.72,0,{map:makeWoodTexture(16,2,4)});
  for(let x=-8;x<=8;x+=4) buildLeadedWindow(parent,x,4.6,-10.7,2.5,3.6);
  addBox(parent,[19,.25,.45],[0,.25,-10.7],trim);
  // Visible beams establish scale and real ceiling support.
  for(let x=-8;x<=8;x+=4) addBox(parent,[.22,8.3,.3],[x,4.15,-10.4],trim);
  const batch=new FloralBatch(config,winter?1010:707);
  for(let row=0;row<3;row++){
    const z=3.8-row*4.1;
    buildTable(parent,[0,0,z],[10.5,.11,1.2],{linen:winter?0xe3e2dc:0xd5c9ba});
    for(let x=-4.5;x<=4.5;x+=1.5) batch.arrangement(new THREE.Vector3(x,.84,z),{count:7,width:.48,depth:.35,height:.34});
    for(let x=-5.1;x<=5.1;x+=1.7){
      buildChair(parent,[x,0,z-1.0],0,{color:winter?0x887f75:0x654d39});
      buildChair(parent,[x,0,z+1.0],Math.PI,{color:winter?0x887f75:0x654d39});
    }
    for(let x=-4.8;x<=4.8;x+=1.6) buildCandle(parent,[x,.86,z+.36],.22+(row%2)*.08,!winter || row===1);
  }
  batch.flush(parent);
  addDust(parent,winter?0xeef7ff:0xffd5a6,220,[20,8,22]);
}

function buildSweetheart(parent,config){
