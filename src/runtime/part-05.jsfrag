  const floor=standardMaterial(0x4e382d,.7,0,{map:makeWoodTexture(38,6,8)});
  addPlane(parent,22,20,[0,0,-2],floor);
  const wall=standardMaterial(0x5d463b,.95);
  addBox(parent,[16,7,.4],[0,3.5,-7.3],wall);
  const stone=standardMaterial(0x78685d,.93,0,{map:makeStoneTexture(88,3,2)});
  addBox(parent,[4.4,3.4,.55],[0,1.7,-7.0],stone);
  addBox(parent,[3.3,2.35,.32],[0,1.15,-6.68],standardMaterial(0x251d1a,.98));
  addBox(parent,[5.0,.3,.75],[0,3.45,-6.85],stone);
  const batch=new FloralBatch(config,808);
  buildTable(parent,[0,0,-2.6],[5.6,.12,1.15],{linen:0xd8cbbd,drape:true});
  batch.arrangement(new THREE.Vector3(-1.65,.86,-2.55),{count:32,width:1.05,depth:.48,height:.58});
  batch.arrangement(new THREE.Vector3(1.6,.86,-2.55),{count:27,width:.95,depth:.45,height:.52});
  // Cascading strand over one edge; gravity direction is explicit.
  for(let i=0;i<18;i++){
    const t=i/17;
    const p=new THREE.Vector3(2.28+t*.34,.78-t*1.25,-2.05+(Math.random()-.5)*.16);
    batch.leaf(p,.3+(1-t)*.08,i%2,new THREE.Vector3(0,.1,1),t*2.3);
    if(i%3===0) batch.bloom(p.clone().add(new THREE.Vector3(-.1,.02,.05)),.21+(1-t)*.08,i%4,new THREE.Vector3(0,.1,1),'lisianthus');
  }
  [-2.3,-1.1,0,1.1,2.3].forEach((x,i)=>buildCandle(parent,[x,.86,-1.95],.32+(i%2)*.15,true));
  // Lanterns on floor, in physically plausible glass-and-metal boxes.
  [-3.5,3.55].forEach((x,j)=>{
    const metal=standardMaterial(0x473b32,.35,.55);
    addBox(parent,[.65,.06,.65],[x,.03,-1.95],metal);
    addBox(parent,[.65,.06,.65],[x,1.1,-1.95],metal);
    [[-.29,-.29],[-.29,.29],[.29,-.29],[.29,.29]].forEach(([dx,dz])=>addBox(parent,[.045,1.08,.045],[x+dx,.57,-1.95+dz],metal));
    buildCandle(parent,[x,0.08,-1.95],.5,true);
  });
  batch.flush(parent);
  addDust(parent,0xffc785,180,[14,7,12]);
}

function buildTropical(parent,config){
  const stone=standardMaterial(0x9d8c70,.9,0,{map:makeStoneTexture(73,6,6)});
  addPlane(parent,30,26,[0,0,-2],stone);
  // Ocean/horizon as actual distant geometry, not a blurred backdrop.
  const ocean=standardMaterial(0x4b858d,.22,0,{transparent:true,opacity:.85});
  addPlane(parent,60,35,[0,-.35,-20],ocean,[0,0,0],false);
  const pergola=standardMaterial(0x74563c,.83,0,{map:makeWoodTexture(53,2,5)});
  [-5.4,5.4].forEach(x=>[-5.6,1.4].forEach(z=>addBox(parent,[.28,5.2,.28],[x,2.6,z],pergola)));
  [-5.4,5.4].forEach(x=>addBox(parent,[.24,.24,7.3],[x,5.14,-2.1],pergola));
  for(let z=-5.6;z<=1.4;z+=1.15) addBox(parent,[11.2,.18,.18],[0,5.25,z],pergola);
  const batch=new FloralBatch(config,1111);
  // Broad structural leaves use full geometry and visible stems.
  const broadLeafMat=standardMaterial(config.leaf[0],.84,0,{side:THREE.DoubleSide});
  for(let side of [-1,1]){
    for(let i=0;i<12;i++){
      const base=new THREE.Vector3(side*4.65,.05,-2.7+(Math.random()-.5)*4.2);
      const top=base.clone().add(new THREE.Vector3(side*(.4+Math.random()*.8),1.25+Math.random()*2.15,(Math.random()-.5)*1.4));
      batch.stem(base,top,.025);
      const leaf=addSphere(parent,.55,top.toArray(),broadLeafMat,10,[.68,1.8,.12]);
      leaf.rotation.z=side*(-.35+Math.random()*.3); leaf.rotation.y=Math.random()*1.2;
      state.sway.push({object:leaf,amount:.015,phase:Math.random()*6});
    }
  }
  batch.arrangement(new THREE.Vector3(-4.7,.15,-2.1),{count:35,width:1.25,depth:.9,height:1.5});
  batch.arrangement(new THREE.Vector3(4.65,.15,-3.0),{count:33,width:1.2,depth:.85,height:1.45});
  buildTable(parent,[0,0,-2.5],[6.5,.12,1.25],{linen:0xe0d5c3});
  for(let x=-2.6;x<=2.6;x+=1.3) batch.arrangement(new THREE.Vector3(x,.84,-2.5),{count:8,width:.5,depth:.38,height:.4});
  batch.flush(parent);
  addDust(parent,0xfff1cc,180,[18,8,17]);
}

function buildOldMaster(parent,config){
  const floor=standardMaterial(0x473329,.78,0,{map:makeWoodTexture(71,5,7)});
  addPlane(parent,22,20,[0,0,-2],floor);
  const wall=standardMaterial(0x30231e,.98);
  addBox(parent,[16,7,.45],[0,3.5,-7.4],wall);
  const batch=new FloralBatch(config,1212);
  const table=buildTable(parent,[0,0,-2.0],[4.9,.14,1.25],{wood:0x513522,cloth:false});
  const urn=standardMaterial(0x605347,.62,.18);
  addCylinder(parent,.5,.35,.85,[0,1.32,-2.0],urn,28);
  addCylinder(parent,.34,.56,.3,[0,1.86,-2.0],urn,28);
  batch.arrangement(new THREE.Vector3(0,1.88,-2.0),{count:52,width:1.55,depth:.76,height:1.45,normal:new THREE.Vector3(-.15,.2,1)});
  // Fallen petals and pruning debris make the still life materially grounded.
  for(let i=0;i<20;i++){
    const p=new THREE.Vector3((Math.random()-.5)*3.3,.88,-1.45+(Math.random()-.5)*.9);
    batch.leaf(p,.16+(Math.random()*.12),i%2,new THREE.Vector3(0,1,0),Math.random()*6);
  }
  buildCandle(parent,[-1.65,.88,-1.6],.65,true);
  buildCandle(parent,[1.45,.88,-2.35],.45,true);
  buildWorkshopTools(parent,[0,0,-2.0]);
  batch.flush(parent);
  addDust(parent,0xffc16f,320,[12,7,11]);
}

function buildMechanics(parent,config){
  const floor=standardMaterial(0x8e918c,.88,0,{map:makeStoneTexture(93,5,5)});
  addPlane(parent,24,20,[0,0,-2],floor);
  const wall=standardMaterial(0xb6bbb7,.95);
  addBox(parent,[17,7,.4],[0,3.5,-7.2],wall);
  const batch=new FloralBatch(config,1313);
  const arch=buildCircularArch(parent,batch,{center:new THREE.Vector3(0,2.45,-1.75),radius:2.28,rangeA:.48,rangeB:2.65,count:36,drape:false});
  // Chicken-wire cages are modeled as crossed structural wires over uncovered half.
  const wire=standardMaterial(0x4c5554,.35,.62);
  for(let a=2.72;a<5.6;a+=.15){
    const x=Math.cos(a)*arch.radius, y=arch.center.y+Math.sin(a)*arch.radius;
    addMesh(parent,new THREE.TorusGeometry(.16,.008,5,16),wire,[x,y,arch.center.z+.02],[Math.PI/2,0,a],[1,.65,1],false,true);
  }
  // Cable ties crossing the ring.
  for(let a=.55;a<2.6;a+=.38){
    const x=Math.cos(a)*arch.radius, y=arch.center.y+Math.sin(a)*arch.radius;
    addMesh(parent,new THREE.TorusGeometry(.065,.009,5,14),standardMaterial(0x202728,.55,.12),[x,y,arch.center.z+.04],[Math.PI/2,0,a],[1,1,1]);
  }
  addDimension(parent,[-2.75,.05,-1.72],[2.75,.05,-1.72],'幅 5.5 m');
  addDimension(parent,[3.05,.1,-1.72],[3.05,4.95,-1.72],'高さ 4.9 m');
  addLabel(parent,'重り 18 kg × 2',[-2.2,.55,-.65],[1.55,.55,1]);
  addLabel(parent,'金属フレーム',[2.35,3.1,-.65],[1.5,.55,1]);
  addLabel(parent,'網＋結束',[2.2,4.2,-.7],[1.35,.5,1]);
  buildBucket(parent,[-4.2,0,1.7],0x667071,true,batch);
  buildCrate(parent,[4.0,0,1.8],[1.05,.55,.75],'WEIGHTS');
  batch.flush(parent);
  addDust(parent,0xffffff,150,[15,7,11]);
}

function buildDiorama(parent,config){
  const plinth=standardMaterial(0x6b503a,.78,0,{map:makeWoodTexture(94,4,2)});
  addBox(parent,[12.6,.8,9.2],[0,.4,-1.2],plinth);
  addBox(parent,[12.2,.14,8.8],[0,.87,-1.2],standardMaterial(0xb6aa98,.9));
  const model=new THREE.Group();
  model.scale.setScalar(.36);
  model.position.set(0,.92,.15);
  parent.add(model);
  const miniConfig={...config,ground:0x7c766c};
  makeGround(model,miniConfig,{width:28,depth:22});
  buildAldieFacade(model,{z:-6.2});
  const batch=new FloralBatch(config,1414);
  buildCircularArch(model,batch,{center:new THREE.Vector3(3.2,2.35,-1.7),radius:2.15,count:48});
  buildStoneFountain(model,batch,{center:new THREE.Vector3(-3.5,0,-1.6),flowerCount:22,water:false});
  buildTable(model,[0,0,3.0],[5.5,.11,1.0],{linen:0xd7cbbd});
  for(let x=-2.1;x<=2.1;x+=1.05) batch.arrangement(new THREE.Vector3(x,.84,3),{count:5,width:.36,depth:.28,height:.28});
  for(let row=0;row<2;row++) for(let col=0;col<5;col++) buildChair(model,[-2.8+col*1.4,0,1.1-row*1.2],Math.PI,{color:0x69503c});
  buildCrate(model,[-5.1,0,4.2],[1.3,.7,.9],'PREP');
  buildBucket(model,[-3.6,0,4.3],0x626a69,true,batch);
  batch.flush(model);
  // Brass scale ruler lies on the plinth to make the miniature status legible.
  const ruler=standardMaterial(0x9d7e4d,.32,.62);
  addBox(parent,[4.2,.035,.24],[-3.1,.92,3.0],ruler,[0,.18,0]);
  for(let i=0;i<20;i++) addBox(parent,[.012,.02,i%5===0?.18:.1],[-5.0+i*.2,.955,3.0+i*.036],standardMaterial(0x4b3b2c,.5,.2),[0,.18,0],false,false);
}

function buildWorld(config) {
  state.sway = [];
  state.candleLights = [];
  state.waterDrops = [];
  state.dust = null;
  currentTextures.forEach((texture) => texture.dispose());
  currentTextures = [];
  if (world) {
    scene.remove(world);
    disposeObject(world);
  }
  world = new THREE.Group();
  scene.add(world);

  switch (config.layout) {
    case 'courtyard': buildCourtyard(world, config); break;
    case 'fountain': buildFountainLayout(world, config); break;
    case 'workshop': buildWorkshop(world, config); break;
    case 'loadin': buildLoadIn(world, config); break;
    case 'garden': buildGarden(world, config); break;
    case 'glasshouse': buildGlasshouse(world, config); break;
    case 'reception': buildReception(world, config, false); break;
    case 'sweetheart': buildSweetheart(world, config); break;
    case 'moon': buildCourtyard(world, config, { water: false, brick: 0x5b4038 }); addMoonCandles(world); break;
    case 'winter': buildReception(world, config, true); break;
    case 'tropical': buildTropical(world, config); break;
    case 'oldmaster': buildOldMaster(world, config); break;
    case 'mechanics': buildMechanics(world, config); break;
    case 'diorama': buildDiorama(world, config); break;
    default: buildCourtyard(world, config);
  }
}

function addMoonCandles(parent) {
  for (let x=-3.8;x<=3.8;x+=1.25) buildCandle(parent,[x,.05,2.45+Math.sin(x)*.12],.28+(Math.abs(x)%1)*.18,true);
  for (let x=-2.8;x<=2.8;x+=1.4) buildCandle(parent,[x,.05,-.25],.22,true);
}

function configureLights(config) {
  if (lightRoot) scene.remove(lightRoot);
  lightRoot = new THREE.Group();
  scene.add(lightRoot);
  const hemi = new THREE.HemisphereLight(config.sky, 0x3a342e, config.hemi);
  lightRoot.add(hemi);
  const sun = new THREE.DirectionalLight(config.sun, config.sunIntensity);
  sun.position.set(...config.sunPos);
  sun.castShadow = true;
  sun.shadow.mapSize.set(1024, 1024);
  sun.shadow.camera.left = -13;
  sun.shadow.camera.right = 13;
  sun.shadow.camera.top = 12;
  sun.shadow.camera.bottom = -7;
  sun.shadow.camera.near = .5;
  sun.shadow.camera.far = 35;
  sun.shadow.bias = -.00018;
  sun.shadow.normalBias = .025;
  lightRoot.add(sun);
  if (config.layout === 'workshop') {
    for (let x=-5;x<=5;x+=5) {
      const task = new THREE.PointLight(0xffead2, 1.4, 8, 2);
      task.position.set(x,5,-1); lightRoot.add(task);
    }
  }
  if (config.layout === 'oldmaster') {
    const fill = new THREE.SpotLight(0xffbc6e, 4.6, 18, .55, .6, 1.5);
    fill.position.set(-4.5,6.2,4.2); fill.target.position.set(0,1.7,-2); fill.castShadow=true;
    lightRoot.add(fill,fill.target);
  }
  if (config.layout === 'mechanics') {
    const fill = new THREE.DirectionalLight(0xcbe4e6, 1.25);
    fill.position.set(7,6,6); lightRoot.add(fill);
  }
}

function responsiveCamera(config) {
  const portrait = innerHeight > innerWidth * 1.1;
  const base = new THREE.Vector3(...config.camera);
  const target = new THREE.Vector3(...config.target);
  if (portrait) {
    base.z += 3.4;
    base.y += .35;
    target.y += .15;
    target.x += config.layout === 'fountain' ? 0 : .45;
  }
  if (innerWidth < 520) base.z += 1.0;
  return { position: base, target, fov: config.fov + (portrait ? 4.5 : 0) };
}

function applyVariant(index, animate = true, direction = 1) {
